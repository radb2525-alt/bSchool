// ═══════════════════════════════════════════
//              Screen Share
// ═══════════════════════════════════════════
async function toggleScreenShare() {
    if (screenSharing) stopScreenShare();
    else await startScreenShare();
}

async function startScreenShare() {
    if (userRole !== 'teacher') {
        addSystemMessage('⚠️ فقط معلم می‌تواند صفحه را اشتراک بگذارد');
        return;
    }
    try {
        screenStream = await navigator.mediaDevices.getDisplayMedia({
            video: { cursor: 'always', frameRate: 15 }, audio: false
        });
        screenSharing = true;
        if (ws && ws.readyState === WebSocket.OPEN) {
            ws.send(JSON.stringify({ type: 'screen_share_start' }));
        }
        const btn = document.getElementById('btnScreen');
        btn.classList.add('off');

        const track = screenStream.getVideoTracks()[0];
        for (const pc of Object.values(peerConnections)) {
            const s = pc.getSenders().find(x => x.track && x.track.kind === 'video');
            if (s) await s.replaceTrack(track);
        }
        document.getElementById('screenViewVideo').srcObject = screenStream;
        setMode('screen');
        track.onended = () => stopScreenShare();
        addSystemMessage('🖥️ اشتراک صفحه شروع شد');
    } catch (e) {
        console.error('❌', e);
        screenSharing = false;
        screenStream = null;
        addSystemMessage(e.name === 'NotAllowedError' ? '⚠️ لغو شد' : '⚠️ ' + e.message);
    }
}

function stopScreenShare() {
    if (!screenSharing) return;
    if (screenStream) { screenStream.getTracks().forEach(t => t.stop()); screenStream = null; }
    screenSharing = false;
    const btn = document.getElementById('btnScreen');
    btn.classList.remove('off');
    if (localStream) {
        const cam = localStream.getVideoTracks()[0];
        for (const pc of Object.values(peerConnections)) {
            const s = pc.getSenders().find(x => x.track && x.track.kind === 'video');
            if (s && cam) s.replaceTrack(cam);
        }
    }
    document.getElementById('screenViewVideo').srcObject = null;
    if (ws && ws.readyState === WebSocket.OPEN) {
        ws.send(JSON.stringify({ type: 'screen_share_stop' }));
    }
    if (userRole === 'teacher') setMode('grid');
    addSystemMessage('🖥️ اشتراک صفحه متوقف شد');
}

// ═══════════════════════════════════════════
//              Whiteboard Core
// ═══════════════════════════════════════════
function initWhiteboard() {
    canvas = document.getElementById('whiteboardCanvas');
    if (!canvas) return;
    ctx = canvas.getContext('2d');

    canvas.addEventListener('mousedown', startDrawing);
    canvas.addEventListener('mousemove', draw);
    canvas.addEventListener('mouseup', stopDrawing);
    canvas.addEventListener('mouseout', stopDrawing);
    canvas.addEventListener('touchstart', handleTouchStart, { passive: false });
    canvas.addEventListener('touchmove', handleTouchMove, { passive: false });
    canvas.addEventListener('touchend', stopDrawing);
    canvas.addEventListener('dblclick', handleDoubleClick);

    window.addEventListener('resize', resizeCanvas);
}

function resizeCanvas() {
    if (!canvas || currentMode !== 'whiteboard') return;
    const cont = canvas.parentElement;
    canvas.width = cont.clientWidth;
    canvas.height = cont.clientHeight;
    if (ctx) {
        ctx.fillStyle = 'white';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        replayHistory();
    }
}

function startDrawing(e) {
    if (currentTool === 'text') return;
    if (!canDrawWhiteboard()) return;
    isDrawing = true;
    const r = canvas.getBoundingClientRect();
    lastX = (e.clientX - r.left) / r.width;
    lastY = (e.clientY - r.top) / r.height;
}

function draw(e) {
    if (!isDrawing || !canDrawWhiteboard()) return;
    const r = canvas.getBoundingClientRect();
    const x = (e.clientX - r.left) / r.width;
    const y = (e.clientY - r.top) / r.height;

    drawLine(lastX * canvas.width, lastY * canvas.height, x * canvas.width, y * canvas.height, currentColor, currentBrushSize, currentTool);

    sendWhiteboard({
        type: 'draw', fromX: lastX, fromY: lastY, toX: x, toY: y,
        color: currentColor, size: currentBrushSize, tool: currentTool,
        author: userName
    });

    lastX = x;
    lastY = y;
}

function stopDrawing() { isDrawing = false; }

function handleTouchStart(e) {
    if (currentTool === 'text' || !canDrawWhiteboard()) return;
    e.preventDefault();
    if (e.touches.length > 0) {
        isDrawing = true;
        const r = canvas.getBoundingClientRect();
        lastX = (e.touches[0].clientX - r.left) / r.width;
        lastY = (e.touches[0].clientY - r.top) / r.height;
    }
}

function handleTouchMove(e) {
    if (currentTool === 'text' || !canDrawWhiteboard()) return;
    e.preventDefault();
    if (!isDrawing || e.touches.length === 0) return;
    const r = canvas.getBoundingClientRect();
    const x = (e.touches[0].clientX - r.left) / r.width;
    const y = (e.touches[0].clientY - r.top) / r.height;
    drawLine(lastX * canvas.width, lastY * canvas.height, x * canvas.width, y * canvas.height, currentColor, currentBrushSize, currentTool);
    sendWhiteboard({
        type: 'draw', fromX: lastX, fromY: lastY, toX: x, toY: y,
        color: currentColor, size: currentBrushSize, tool: currentTool,
        author: userName
    });
    lastX = x;
    lastY = y;
}

function handleDoubleClick(e) {
    if (!canDrawWhiteboard()) return;
    e.preventDefault();
    const r = canvas.getBoundingClientRect();
    showTextInput((e.clientX - r.left) / r.width, (e.clientY - r.top) / r.height);
}

function drawLine(x1, y1, x2, y2, color, size, tool) {
    if (!ctx) return;
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2, y2);
    if (tool === 'eraser') {
        ctx.strokeStyle = 'white';
        ctx.lineWidth = size * 5;
    } else {
        ctx.strokeStyle = color;
        ctx.lineWidth = size;
    }
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.stroke();
}

function drawText(x, y, text, color, size) {
    if (!ctx || !text) return;
    ctx.fillStyle = color;
    ctx.font = `${size}px Tahoma`;
    ctx.textBaseline = 'top';
    ctx.fillText(text, x, y);
}

// ═══════════════════════════════════════════
//              Text Tool
// ═══════════════════════════════════════════
function showTextInput(nx, ny) {
    if (!canDrawWhiteboard()) return;
    if (pendingTextInput) { pendingTextInput.remove(); pendingTextInput = null; }

    const r = canvas.getBoundingClientRect();
    const input = document.createElement('input');
    input.type = 'text';
    input.placeholder = 'متن...';
    input.style.cssText = `position:absolute;left:${nx * r.width}px;top:${ny * r.height}px;background:rgba(255,255,255,0.95);border:2px solid #e94560;padding:5px 10px;font-size:16pt;font-family:Tahoma;z-index:100;min-width:200px;border-radius:4px;outline:none;`;
    canvas.parentElement.appendChild(input);
    input.focus();
    pendingTextInput = input;

    input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
            const text = input.value.trim();
            if (text) {
                drawText(nx * canvas.width, ny * canvas.height, text, currentColor, currentBrushSize * 8);
                sendWhiteboard({
                    type: 'text', x: nx, y: ny, text, color: currentColor,
                    size: currentBrushSize, author: userName
                });
            }
            input.remove();
            pendingTextInput = null;
        } else if (e.key === 'Escape') {
            input.remove();
            pendingTextInput = null;
        }
    });

    input.addEventListener('blur', () => {
        setTimeout(() => {
            if (pendingTextInput === input) { input.remove(); pendingTextInput = null; }
        }, 200);
    });
}

// ═══════════════════════════════════════════
//              Tools
// ═══════════════════════════════════════════
function setColor(color, el) {
    currentColor = color;
    if (currentTool !== 'pen') { setTool('pen'); }
    document.querySelectorAll('.wb-color').forEach(e => e.classList.remove('active'));
    el.classList.add('active');
}

function setBrushSize(size) {
    currentBrushSize = parseInt(size);
    document.getElementById('brushSizeLabel').textContent = size;
}

function setTool(tool) {
    currentTool = tool;
    ['pen', 'eraser', 'text'].forEach(t => {
        const btn = document.getElementById('tool' + t.charAt(0).toUpperCase() + t.slice(1));
        if (btn) btn.classList.toggle('active', t === tool);
    });
    if (canvas) canvas.style.cursor = tool === 'text' ? 'text' : 'crosshair';
}

function clearWhiteboard() {
    if (!canDrawWhiteboard() || !ctx) return;
    ctx.fillStyle = 'white';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    sendWhiteboard({ type: 'clear', author: userName });
    whiteboardHistory = [];
    addSystemMessage('🗑️ تخته پاک شد');
}

// ═══════════════════════════════════════════
//              Whiteboard Network
// ═══════════════════════════════════════════
function sendWhiteboard(data) {
    if (ws && ws.readyState === WebSocket.OPEN) {
        ws.send(JSON.stringify({ type: 'whiteboard', data }));
    }
}

function handleWhiteboard(data) {
    if (!data) return;

    if (data.type !== 'clear') {
        whiteboardHistory.push(data);
        if (whiteboardHistory.length > 5000) whiteboardHistory.shift();
    } else {
        whiteboardHistory = [];
    }

    if (currentMode !== 'whiteboard' || !ctx) return;
    if (!canViewWhiteboard()) return;

    if (data.type === 'draw') {
        drawLine(
            data.fromX * canvas.width, data.fromY * canvas.height,
            data.toX * canvas.width, data.toY * canvas.height,
            data.color, data.size, data.tool
        );
    } else if (data.type === 'text') {
        drawText(data.x * canvas.width, data.y * canvas.height, data.text, data.color, data.size * 8);
    } else if (data.type === 'clear') {
        ctx.fillStyle = 'white';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
    }
}

function replayHistory() {
    if (!ctx || !whiteboardHistory.length) return;
    whiteboardHistory.forEach(data => {
        if (data.type === 'draw') {
            drawLine(
                data.fromX * canvas.width, data.fromY * canvas.height,
                data.toX * canvas.width, data.toY * canvas.height,
                data.color, data.size, data.tool
            );
        } else if (data.type === 'text') {
            drawText(data.x * canvas.width, data.y * canvas.height, data.text, data.color, data.size * 8);
        } else if (data.type === 'clear') {
            ctx.fillStyle = 'white';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
        }
    });
}

// ═══════════════════════════════════════════
//              Leave
// ═══════════════════════════════════════════
function leaveRoom() {
    if (!confirm('از کلاس خارج می‌شوید؟')) return;
    intentionalClose = true;
    if (screenSharing) stopScreenShare();
    if (localStream) localStream.getTracks().forEach(t => t.stop());
    Object.keys(peerConnections).forEach(id => peerConnections[id].close());
    if (ws) ws.close();
    location.reload();
}

// ═══════════════════════════════════════════
//              Init
// ═══════════════════════════════════════════
window.addEventListener('DOMContentLoaded', () => {
    initWhiteboard();
    console.log('✅ App v3.3 initialized');
});

// بستن سایدبارها با کلیک خارج
document.addEventListener('click', (e) => {
    if (activeSidebar) {
        const panel = document.getElementById('sidebar' + activeSidebar.charAt(0).toUpperCase() + activeSidebar.slice(1));
        const trigger = document.getElementById('trigger' + activeSidebar.charAt(0).toUpperCase() + activeSidebar.slice(1));
        if (panel && !panel.contains(e.target) && trigger && !trigger.contains(e.target)) {
            closeSidebar(activeSidebar);
        }
    }
});

setInterval(() => {
    if (ws && ws.readyState === WebSocket.OPEN) ws.send(JSON.stringify({ type: 'ping' }));
}, 30000);

window.addEventListener('beforeunload', () => {
    if (localStream) localStream.getTracks().forEach(t => t.stop());
    if (screenStream) screenStream.getTracks().forEach(t => t.stop());
    if (ws && ws.readyState === WebSocket.OPEN) ws.close();
});
</script>

