        input.value = url;
        serverSettings.serverAddress = url;
        saveServerSettings();
        updateWebSocketUrl();
    }
}


// ═══════════════════════════════════════════
//              Test Server Connection
// ═══════════════════════════════════════════
async function testServerConnection() {
    const input = document.getElementById('inputServerAddress');
    const result = document.getElementById('connectionResult');
    const btn = document.getElementById('testConnectionBtn');
    
    let address = input.value.trim();
    
    if (!address) {
        showConnectionResult('error', '❌ آدرس سرور خالی است', 'لطفاً آدرس سرور را وارد کنید');
        return;
    }
    
    // اگر پروتکل نداشت
    if (!address.startsWith('http://') && !address.startsWith('https://')) {
        address = 'http://' + address;
        input.value = address;
    }
    
    // حذف / انتها
    address = address.replace(/\/$/, '');
    
    // ذخیره
    serverSettings.serverAddress = address;
    saveServerSettings();
    
    // UI: حالت در حال تست
    btn.disabled = true;
    btn.textContent = '⏳ در حال تست...';
    showConnectionResult('loading', '⏳ در حال بررسی...', 'لطفاً صبر کنید...');
    
    const startTime = Date.now();
    
    try {
        // ۱. تست HTTP — Health endpoint
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 5000);
        
        const httpRes = await fetch(address + '/health', {
            method: 'GET',
            signal: controller.signal
        });
        clearTimeout(timeoutId);
        
        if (!httpRes.ok) {
            throw new Error('HTTP ' + httpRes.status);
        }
        
        const healthData = await httpRes.json();
        
        if (healthData.status !== 'ok') {
            throw new Error('سرور پاسخ نامعتبر');
        }
        
        // ۲. تست WebSocket
        const wsUrl = buildWebSocketUrl(address);
        
        const wsTest = await new Promise((resolve) => {
            const testWs = new WebSocket(wsUrl);
            const timeout = setTimeout(() => {
                testWs.close();
                resolve({ ok: false, error: 'WebSocket تایم‌اوت (۵ ثانیه)' });
            }, 5000);
            
            testWs.onopen = () => {
                clearTimeout(timeout);
                testWs.close();
                resolve({ ok: true });
            };
            
            testWs.onerror = () => {
                clearTimeout(timeout);
                resolve({ ok: false, error: 'WebSocket خطا' });
            };
        });
        
        if (!wsTest.ok) {
            throw new Error(wsTest.error);
        }
        
        // ✅ موفق
        const elapsed = Date.now() - startTime;
        const version = healthData.service || healthData.version || 'نامشخص';
        const uptime = healthData.uptime ? Math.floor(healthData.uptime) + ' ثانیه' : '—';
        
        showConnectionResult('success', 
            '✅ اتصال برقرار شد',
            `📊 نسخه سرور: ${version}<br>🕐 زمان پاسخ: ${elapsed}ms<br>⚡ Uptime: ${uptime}`
        );
        
        // ذخیره
        serverSettings.serverAddress = address;
        saveServerSettings();
        updateWebSocketUrl();
        
    } catch (e) {
        let errorMsg = '❌ اتصال برقرار نشد';
        let details = '';
        
        if (e.name === 'AbortError') {
            details = '⏱️ سرور پاسخ نداد (تایم‌اوت ۵ ثانیه)';
        } else if (e.message.includes('HTTP')) {
            details = '🚫 سرور پاسخ خطا داد: ' + e.message;
        } else if (e.message.includes('WebSocket')) {
            details = '🔌 WebSocket برقرار نشد: ' + e.message;
        } else if (e.message.includes('Failed to fetch') || e.name === 'TypeError') {
            details = '🌐 سرور در دسترس نیست<br>• آدرس را چک کنید<br>• سرور روشن است؟<br>• پورت باز است؟';
        } else {
            details = '⚠️ ' + e.message;
        }
        
        showConnectionResult('error', errorMsg, details);
        
    } finally {
        btn.disabled = false;
        btn.textContent = '🔌 تست اتصال';
    }
}

function showConnectionResult(type, title, detail) {
    const result = document.getElementById('connectionResult');
    if (!result) return;
    
    result.className = 'connection-result visible ' + type;
    result.innerHTML = `
        <div class="result-title">${title}</div>
        <div class="result-detail">${detail}</div>
    `;
}

// ═══════════════════════════════════════════
//              Load/Save Settings
// ═══════════════════════════════════════════
function loadChatSettings() {
    try {
        const saved = localStorage.getItem('classroom_chat_settings');
        if (saved) {
            chatSettings = { ...chatSettings, ...JSON.parse(saved) };
        }
    } catch (e) {
        console.log('⚠️ Could not load settings:', e);
    }
    applyChatSettingsUI();
}

function saveChatSettings() {
    chatSettings.sound = document.getElementById('settingSound')?.checked ?? true;
    chatSettings.icon = document.getElementById('settingIcon')?.checked ?? true;
    chatSettings.ticker = document.getElementById('settingTicker')?.checked ?? true;

    try {
        localStorage.setItem('classroom_chat_settings', JSON.stringify(chatSettings));
    } catch (e) {
        console.log('⚠️ Could not save settings:', e);
    }

    applyChatSettingsUI();
    updateChatTicker();
    console.log('💾 Settings saved:', chatSettings);
}

function applyChatSettingsUI() {
    const s = document.getElementById('settingSound');
    const i = document.getElementById('settingIcon');
    const t = document.getElementById('settingTicker');
    if (s) s.checked = chatSettings.sound;
    if (i) i.checked = chatSettings.icon;
    if (t) t.checked = chatSettings.ticker;

    // به‌روزرسانی دکمه قطع صدا
    const btn = document.getElementById('soundToggleBtn');
    if (btn) {
        if (chatSettings.muted) {
            btn.textContent = '🔇 وصل صدا';
            btn.classList.add('muted');
        } else {
            btn.textContent = '🔊 قطع صدا';
            btn.classList.remove('muted');
        }
    }

    // نمایش/مخفی نوار پیام‌ها
    const ticker = document.getElementById('chatTicker');
    if (ticker) {
        if (chatSettings.ticker) {
            ticker.classList.remove('hidden');
        } else {
            ticker.classList.add('hidden');
        }
    }
}

function toggleSoundMute() {
    chatSettings.muted = !chatSettings.muted;
    try {
        localStorage.setItem('classroom_chat_settings', JSON.stringify(chatSettings));
    } catch (e) {}
    applyChatSettingsUI();
    console.log('🔊 Muted:', chatSettings.muted);
}

// ═══════════════════════════════════════════
//              Play Ding Sound
// ═══════════════════════════════════════════
async function playDing(isTest = false) {
    if (!isTest && (!chatSettings.sound || chatSettings.muted)) return;

    // ۱. تلاش برای فایل خارجی
    try {
        if (!notificationAudio) {
            notificationAudio = new Audio('notification.mp3');
            notificationAudio.volume = 0.5;
        }
        notificationAudio.currentTime = 0;
        await notificationAudio.play();
        console.log('🔔 Played from file');
        return;
    } catch (e) {
        // فایل نیست، تولید می‌کنیم
    }

    // ۲. تولید صدا با Web Audio API
    playGeneratedDing();
}

function playGeneratedDing() {
    try {
        if (!audioContext) {
            audioContext = new (window.AudioContext || window.webkitAudioContext)();
        }
        
        // Resume اگر معلق است (برای autoplay policy)
        if (audioContext.state === 'suspended') {
            audioContext.resume();
        }

        const now = audioContext.currentTime;

        // صدای اول (بالا)
        const osc1 = audioContext.createOscillator();
        const gain1 = audioContext.createGain();
        osc1.connect(gain1);
        gain1.connect(audioContext.destination);
        osc1.frequency.value = 880;
        osc1.type = 'sine';
        gain1.gain.setValueAtTime(0.25, now);
        gain1.gain.exponentialRampToValueAtTime(0.01, now + 0.4);
        osc1.start(now);
        osc1.stop(now + 0.4);

        // صدای دوم (پایین)
        const osc2 = audioContext.createOscillator();
        const gain2 = audioContext.createGain();
        osc2.connect(gain2);
        gain2.connect(audioContext.destination);
        osc2.frequency.value = 660;
        osc2.type = 'sine';
        gain2.gain.setValueAtTime(0.2, now + 0.12);
        gain2.gain.exponentialRampToValueAtTime(0.01, now + 0.12 + 0.3);
        osc2.start(now + 0.12);
        osc2.stop(now + 0.12 + 0.3);

        console.log('🔔 Played generated ding');
    } catch (e) {
        console.error('❌ Audio error:', e);
    }
}

// ═══════════════════════════════════════════
//              Chat Ticker (Header)
// ═══════════════════════════════════════════
function updateChatTicker() {
    const ticker = document.getElementById('chatTicker');
    if (!ticker) return;

    if (!chatSettings.ticker) {
        ticker.classList.add('hidden');
        return;
    }

    // اگر پیامی نیست
    if (lastMessages.length === 0) {
        ticker.classList.add('hidden');
        return;
    }

    ticker.classList.remove('hidden');

    // نمایش ۳ پیام آخر (خط ۱ = قدیمی‌تر، خط ۳ = جدیدتر)
    const lines = [
        document.getElementById('tickerLine1'),
        document.getElementById('tickerLine2'),
        document.getElementById('tickerLine3')
    ];

    // مرتب‌سازی: از قدیمی به جدید (تا خط ۳ جدیدترین باشد)
    const displayMessages = lastMessages.slice(-3);

    lines.forEach((line, idx) => {
        if (!line) return;
        const msg = displayMessages[idx];
        if (msg) {
            line.innerHTML = `<span class="ticker-user">💬 ${escapeHtml(msg.user)}:</span> <span class="ticker-message">${escapeHtml(msg.message)}</span>`;
            line.style.display = 'flex';
        } else {
            line.innerHTML = '';
            line.style.display = 'none';
        }
    });
}

function addMessageToTicker(user, message, time) {
    lastMessages.push({ user, message, time });
    // فقط ۳ پیام آخر را نگه دار
    if (lastMessages.length > 3) {
        lastMessages = lastMessages.slice(-3);
    }
    updateChatTicker();
}

// ═══════════════════════════════════════════
