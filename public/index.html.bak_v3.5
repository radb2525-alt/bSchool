<!DOCTYPE html>
<html dir="rtl" lang="fa">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>کلاس آنلاین v3.3 - مدرسه هوشمند</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: Tahoma, sans-serif; }
        body { background: #1a1a2e; color: #eee; height: 100vh; overflow: hidden; }

        /* ═══════════════════════════════════════════ */
        /*              Join Modal                     */
        /* ═══════════════════════════════════════════ */
        .modal { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); display: flex; align-items: center; justify-content: center; z-index: 10000; }
        .modal.hidden { display: none; }
        .modal-content { background: #16213e; padding: 40px; border-radius: 15px; width: 450px; max-width: 90%; text-align: center; box-shadow: 0 10px 50px rgba(0,0,0,0.5); }
        .modal-content h1 { color: #e94560; margin-bottom: 25px; font-size: 22pt; }
        .modal-content input, .modal-content select { width: 100%; padding: 12px; margin-bottom: 15px; border: 2px solid #0f3460; border-radius: 8px; background: #0f3460; color: white; font-size: 13pt; font-family: Tahoma, sans-serif; }
        .modal-content input:focus, .modal-content select:focus { outline: none; border-color: #e94560; }
        .modal-content button { width: 100%; padding: 15px; background: linear-gradient(135deg, #667eea, #764ba2); color: white; border: none; border-radius: 8px; font-size: 15pt; font-weight: bold; cursor: pointer; transition: all 0.3s; }
        .modal-content button:hover { transform: scale(1.02); }

        /* ═══════════════════════════════════════════ */
        /*              App Layout                     */
        /* ═══════════════════════════════════════════ */
        #app { display: none; flex-direction: column; height: 100vh; width: 100vw; }
        #app.visible { display: flex; }

        /* ═══ Top Bar ═══ */
        .top-bar {
            background: linear-gradient(90deg, #16213e 0%, #0f3460 100%);
            padding: 0 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #0f3460;
            height: 55px;
            flex-shrink: 0;
            z-index: 50;
        }
        .top-bar .left, .top-bar .center, .top-bar .right { display: flex; gap: 15px; align-items: center; }
        .app-logo { font-size: 13pt; font-weight: bold; color: #667eea; }
        .mode-indicator {
            background: rgba(15, 52, 96, 0.7);
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 10pt;
            font-weight: bold;
            color: #4CAF50;
            border: 1px solid rgba(76, 175, 80, 0.3);
        }
        .mode-indicator.whiteboard { color: #9C27B0; border-color: rgba(156, 39, 176, 0.3); }
        .mode-indicator.screen { color: #FF5722; border-color: rgba(255, 87, 34, 0.3); }
        .mode-indicator.camera { color: #2196F3; border-color: rgba(33, 150, 243, 0.3); }
        .room-badge { color: #999; font-size: 10pt; }
        .room-badge b { color: #e94560; }
        .online-badge { color: #4CAF50; font-size: 11pt; font-weight: bold; }
        .connection-status { font-size: 10pt; display: flex; align-items: center; gap: 5px; }
        .connection-status::before { content: '●'; font-size: 12pt; }
        .connection-status.online { color: #4CAF50; }
        .connection-status.offline { color: #f44336; }

        /* ═══════════════════════════════════════════ */
        /*              Content Area                   */
        /* ═══════════════════════════════════════════ */
        .content-area { flex: 1; display: flex; min-height: 0; position: relative; overflow: hidden; }
        .main-stage { flex: 1; display: flex; flex-direction: column; padding: 10px; min-width: 0; position: relative; }

        /* ═══ Views ═══ */
        .view { display: none; width: 100%; height: 100%; }
        .view.active { display: flex; flex-direction: column; }

        #gridView .videos-grid {
            flex: 1;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 10px;
            overflow-y: auto;
            align-content: start;
            padding: 5px;
        }

        .video-container {
            background: #0f3460;
            border-radius: 12px;
            position: relative;
            min-height: 180px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            aspect-ratio: 4/3;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        }
        .video-container video { width: 100%; height: 100%; object-fit: cover; }
        .user-label {
            position: absolute;
            bottom: 10px;
            right: 10px;
            background: rgba(0,0,0,0.75);
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 10pt;
        }
        .user-label.teacher { background: linear-gradient(135deg, #e94560, #c73650); }
        .user-label.hand-raised { background: #FF9800; animation: pulse 1s infinite; }
        .mic-status { position: absolute; top: 10px; left: 10px; font-size: 12pt; background: rgba(0,0,0,0.6); padding: 4px 8px; border-radius: 50%; }
        .hand-indicator { position: absolute; top: 10px; right: 10px; font-size: 24pt; animation: wave 1s infinite; }

        @keyframes pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.05); } }
        @keyframes wave { 0%,100% { transform: rotate(-10deg); } 50% { transform: rotate(10deg); } }

        /* Camera View */
        #cameraView {
            align-items: center;
            justify-content: center;
            background: #000;
            border-radius: 12px;
            overflow: hidden;
        }
        #cameraView video { width: 100%; height: 100%; object-fit: contain; }

        /* Screen View */
        #screenView {
            align-items: center;
            justify-content: center;
            background: #000;
            border-radius: 12px;
            overflow: hidden;
        }
        #screenView video { width: 100%; height: 100%; object-fit: contain; }

        /* Whiteboard View */
        #whiteboardView { background: white; border-radius: 12px; overflow: hidden; position: relative; }
        .wb-tools-bar {
            background: #16213e;
            padding: 8px 15px;
            display: flex;
            gap: 8px;
            align-items: center;
            flex-wrap: wrap;
            border-bottom: 2px solid #0f3460;
            flex-shrink: 0;
        }
        .wb-canvas-wrap { flex: 1; position: relative; background: white; }
        #whiteboardCanvas { width: 100%; height: 100%; cursor: crosshair; display: block; touch-action: none; }

        .wb-btn {
            padding: 6px 12px;
            border: none;
            border-radius: 6px;
            background: #0f3460;
            color: white;
            cursor: pointer;
            font-size: 10pt;
            font-weight: bold;
            transition: all 0.2s;
        }
        .wb-btn.active { background: #e94560; }
        .wb-btn:hover { background: #e94560; }
        .wb-color {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            border: 2px solid white;
            cursor: pointer;
            transition: transform 0.2s;
        }
        .wb-color:hover { transform: scale(1.15); }
        .wb-color.active { border-color: #e94560; transform: scale(1.25); box-shadow: 0 0 12px #e94560; }
        .wb-size-range { width: 90px; }

        /* No Access Message */
        #noAccessMsg {
            display: none;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: #16213e;
            color: #e94560;
            padding: 30px 50px;
            border-radius: 15px;
            font-size: 15pt;
            font-weight: bold;
            text-align: center;
            z-index: 100;
            box-shadow: 0 10px 40px rgba(0,0,0,0.5);
            border: 2px solid #e94560;
        }

        /* ═══════════════════════════════════════════ */
        /*              Hover Sidebars                 */
        /* ═══════════════════════════════════════════ */
        .sidebar-trigger {
            position: fixed;
            left: 0;
            top: 55px;
            bottom: 0;
            width: 50px;
            z-index: 300;
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 12px;
            padding: 10px 0;
            pointer-events: none;
        }
        .sidebar-trigger-btn {
            pointer-events: auto;
            width: 42px;
            height: 42px;
            margin: 0 auto;
            border-radius: 0 22px 22px 0;
            background: rgba(22, 33, 62, 0.9);
            backdrop-filter: blur(10px);
            border: 2px solid rgba(102, 126, 234, 0.3);
            border-left: none;
            color: white;
            font-size: 16pt;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
            box-shadow: 4px 4px 15px rgba(0,0,0,0.3);
        }
        .sidebar-trigger-btn:hover {
            width: 50px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            border-color: #667eea;
        }
        .sidebar-trigger-btn.active {
            width: 50px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            border-color: #667eea;
        }
        .sidebar-trigger-btn:disabled {
            opacity: 0.3;
            cursor: not-allowed;
        }

        .sidebar-panel {
            position: fixed;
            left: 50px;
            top: 55px;
            bottom: 0;
            width: 0;
            background: #16213e;
            border-right: 2px solid #0f3460;
            box-shadow: 5px 0 30px rgba(0,0,0,0.5);
            overflow: hidden;
            transition: width 0.3s ease;
            z-index: 299;
            display: flex;
            flex-direction: column;
        }
        .sidebar-panel.open {
            width: 340px;
        }
        .sidebar-panel-header {
            background: linear-gradient(90deg, #0f3460, #16213e);
            padding: 12px 20px;
            font-weight: bold;
            color: #e94560;
            font-size: 12pt;
            border-bottom: 2px solid #0f3460;
            flex-shrink: 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            white-space: nowrap;
        }
        .sidebar-panel-body {
            flex: 1;
            overflow-y: auto;
            padding: 15px;
            min-width: 340px;
        }

        /* Chat Sidebar */
        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 10px;
            display: flex;
            flex-direction: column;
            gap: 6px;
            min-width: 300px;
        }
        .chat-msg {
            background: #0f3460;
            padding: 8px 12px;
            border-radius: 8px;
            font-size: 10pt;
            word-wrap: break-word;
        }
        .chat-msg .user { color: #e94560; font-weight: bold; font-size: 9pt; }
        .chat-msg .time { color: #666; font-size: 8pt; float: left; }
        .chat-msg.system { background: #0a0f1f; color: #888; font-size: 9pt; text-align: center; }
        .chat-input {
            display: flex;
            gap: 5px;
            padding: 10px;
            border-top: 2px solid #0f3460;
            flex-shrink: 0;
            min-width: 340px;
        }
        .chat-input input {
            flex: 1;
            padding: 10px;
            border: none;
            border-radius: 20px;
            background: #0f3460;
            color: white;
            font-size: 10pt;
        }
        .chat-input input:focus { outline: 1px solid #e94560; }
        .chat-input button {
            padding: 8px 15px;
            background: #e94560;
            border: none;
            border-radius: 20px;
            color: white;
            cursor: pointer;
            font-size: 14pt;
        }

        /* Participants Sidebar */
        .participants-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
            min-width: 300px;
        }
        .participant-item {
            background: #0f3460;
            padding: 12px 15px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 11pt;
            transition: all 0.2s;
        }
        .participant-item.teacher {
            background: linear-gradient(135deg, #e94560, #c73650);
        }
        .participant-item:hover {
            transform: translateX(3px);
        }
        .participant-item .role-icon { font-size: 14pt; }
        .participant-item .name { flex: 1; font-weight: bold; }
        .participant-item .status { font-size: 10pt; }

        /* Control Sidebar */
        .control-section {
            background: #0f3460;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 15px;
            min-width: 300px;
        }
        .control-section h3 {
            color: #e94560;
            font-size: 11pt;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .mode-buttons-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }
        .mode-btn {
            padding: 12px 10px;
            border: 2px solid #1e3a5f;
            border-radius: 10px;
            background: #16213e;
            color: white;
            cursor: pointer;
            font-size: 11pt;
            font-weight: bold;
            transition: all 0.2s;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 5px;
        }
        .mode-btn:hover {
            border-color: #667eea;
            transform: translateY(-2px);
        }
        .mode-btn.active {
            background: linear-gradient(135deg, #667eea, #764ba2);
            border-color: #667eea;
        }
        .mode-btn .mode-icon { font-size: 20pt; }
        .mode-btn .mode-label { font-size: 10pt; }

        .control-btn {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 10px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            cursor: pointer;
            font-size: 11pt;
            font-weight: bold;
            margin-bottom: 8px;
            transition: all 0.2s;
        }
        .control-btn:hover { transform: scale(1.02); }
        .control-btn.secondary {
            background: #16213e;
            border: 2px solid #1e3a5f;
        }
        .control-btn.danger {
            background: #f44336;
        }

        .info-line {
            display: flex;
            justify-content: space-between;
            padding: 6px 0;
            font-size: 10pt;
            color: #ccc;
            border-bottom: 1px solid #1e3a5f;
        }
        .info-line:last-child { border-bottom: none; }
        .info-line .value { color: #4CAF50; font-weight: bold; }

        /* ═══════════════════════════════════════════ */
        /*              Glass Control Bar              */
        /* ═══════════════════════════════════════════ */
        .glass-control-bar {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(22, 33, 62, 0.7);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(102, 126, 234, 0.3);
            border-radius: 30px;
            padding: 8px 15px;
            display: flex;
            gap: 8px;
            align-items: center;
            box-shadow: 0 10px 40px rgba(0,0,0,0.6);
            z-index: 250;
            transition: all 0.3s;
        }
        .glass-control-bar:hover {
            background: rgba(22, 33, 62, 0.95);
            border-color: rgba(102, 126, 234, 0.6);
        }

        .glass-btn {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            border: none;
            background: rgba(15, 52, 96, 0.8);
            color: white;
            cursor: pointer;
            font-size: 18pt;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }
        .glass-btn:hover {
            transform: scale(1.1);
            background: rgba(102, 126, 234, 0.5);
        }
        .glass-btn.active {
            background: linear-gradient(135deg, #4CAF50, #388E3C);
        }
        .glass-btn.off {
            background: linear-gradient(135deg, #f44336, #c62828);
        }
        .glass-btn.raised {
            background: linear-gradient(135deg, #FF9800, #F57C00);
            animation: pulse 1s infinite;
        }
        .glass-btn.danger {
            background: linear-gradient(135deg, #f44336, #c62828);
        }
        .glass-btn .tooltip {
            position: absolute;
            bottom: -30px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0,0,0,0.9);
            color: white;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 9pt;
            white-space: nowrap;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.2s;
        }
        .glass-btn:hover .tooltip {
            opacity: 1;
        }

        .glass-divider {
            width: 1px;
            height: 30px;
            background: rgba(102, 126, 234, 0.4);
            margin: 0 3px;
        }

        .glass-btn.whiteboard-btn {
            background: rgba(156, 39, 176, 0.5);
        }
        .glass-btn.whiteboard-btn:hover {
            background: rgba(156, 39, 176, 0.8);
        }
        .glass-btn.screen-btn {
            background: rgba(255, 87, 34, 0.5);
        }
        .glass-btn.screen-btn:hover {
            background: rgba(255, 87, 34, 0.8);
        }

        /* ═══════════════════════════════════════════ */
        /*              Permissions Modal              */
        /* ═══════════════════════════════════════════ */
        .permissions-modal {
            position: fixed;
            top: 0; left: 0;
            width: 100vw; height: 100vh;
            background: rgba(0,0,0,0.85);
            display: none;
            z-index: 10001;
            align-items: center;
            justify-content: center;
        }
        .permissions-modal.show { display: flex; }
        .permissions-content {
            background: #16213e;
            border-radius: 15px;
            width: 600px;
            max-width: 95vw;
            max-height: 90vh;
            display: flex;
            flex-direction: column;
            box-shadow: 0 20px 60px rgba(0,0,0,0.7);
            overflow: hidden;
        }
        .permissions-header {
            background: #0f3460;
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #667eea;
        }
        .permissions-header h2 { color: #667eea; font-size: 15pt; margin: 0; }
        .permissions-body { flex: 1; overflow-y: auto; padding: 20px; }
        .permission-section {
            margin-bottom: 25px;
            padding: 15px;
            background: #0f3460;
            border-radius: 10px;
        }
        .permission-section h3 { color: #e94560; font-size: 12pt; margin-bottom: 12px; }
        .radio-group { display: flex; flex-direction: column; gap: 8px; margin-bottom: 15px; }
        .radio-group label {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 12px;
            background: #16213e;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 11pt;
        }
        .radio-group label:hover { background: #1e3a5f; }
        .radio-group input[type="radio"] { width: 18px; height: 18px; accent-color: #667eea; cursor: pointer; }
        .user-list {
            margin-top: 10px;
            padding: 10px;
            background: #16213e;
            border-radius: 8px;
            display: none;
        }
        .user-list.visible { display: block; }
        .user-list-title { color: #999; font-size: 10pt; margin-bottom: 8px; }
        .checkboxes { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; }
        .checkbox-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            background: #0f3460;
            border-radius: 6px;
            cursor: pointer;
            font-size: 10pt;
            transition: all 0.2s;
        }
        .checkbox-item:hover { background: #1e3a5f; }
        .checkbox-item input[type="checkbox"] { width: 16px; height: 16px; accent-color: #4CAF50; cursor: pointer; }
        .permissions-footer {
            background: #0f3460;
            padding: 15px 20px;
            display: flex;
            gap: 10px;
            justify-content: flex-end;
            border-top: 2px solid #667eea;
        }
        .permissions-btn {
            padding: 12px 25px;
            border: none;
            border-radius: 25px;
            cursor: pointer;
            font-size: 11pt;
            font-weight: bold;
            transition: all 0.2s;
        }
        .permissions-btn:hover { transform: scale(1.05); }
        .permissions-btn.save { background: linear-gradient(135deg, #667eea, #764ba2); color: white; }
        .permissions-btn.cancel { background: #f44336; color: white; }

        /* ═══════════════════════════════════════════ */
        /*              Join Modal — Advanced          */
        /* ═══════════════════════════════════════════ */
        .modal-content .modal-subtitle {
            color: #999;
            font-size: 11pt;
            margin-bottom: 25px;
        }

        .input-hint {
            color: #667eea;
            font-size: 9pt;
            margin-top: -10px;
            margin-bottom: 12px;
            padding-right: 5px;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .modal-section {
            background: #0f3460;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 15px;
            text-align: right;
        }

        .modal-section-title {
            color: #e94560;
            font-size: 11pt;
            font-weight: bold;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .advanced-toggle {
            background: transparent;
            border: none;
            color: #667eea;
            cursor: pointer;
            font-size: 10pt;
            font-weight: bold;
            padding: 4px 10px;
            border-radius: 6px;
            transition: all 0.2s;
        }

        .advanced-toggle:hover {
            background: rgba(102, 126, 234, 0.2);
        }

        .advanced-content {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.4s ease;
        }

        .advanced-content.open {
            max-height: 800px;
        }

        .server-mode-options {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-bottom: 15px;
        }

        .server-mode-option {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 12px;
            background: #16213e;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s;
            border: 2px solid transparent;
        }

        .server-mode-option:hover {
            background: #1e3a5f;
        }

        .server-mode-option.selected {
            border-color: #667eea;
            background: #1e3a5f;
        }

        .server-mode-option input[type="radio"] {
            margin-top: 3px;
            width: 18px;
            height: 18px;
            accent-color: #667eea;
            cursor: pointer;
            flex-shrink: 0;
        }

        .server-mode-option .option-content {
            flex: 1;
        }

        .server-mode-option .option-title {
            color: #eee;
            font-size: 11pt;
            font-weight: bold;
            margin-bottom: 3px;
        }

        .server-mode-option .option-desc {
            color: #999;
            font-size: 9pt;
            line-height: 1.4;
        }

        .server-address-box {
            display: none;
            margin-top: 15px;
            padding: 12px;
            background: #16213e;
            border-radius: 8px;
            border-right: 3px solid #667eea;
        }

        .server-address-box.visible {
            display: block;
        }

        .server-address-box label {
            display: block;
            color: #ccc;
            font-size: 10pt;
            margin-bottom: 8px;
        }

        .server-address-box input {
            width: 100%;
            padding: 10px 12px;
            background: #0f3460;
            border: 2px solid #1e3a5f;
            border-radius: 6px;
            color: white;
            font-size: 11pt;
            font-family: 'Courier New', monospace;
            direction: ltr;
            text-align: left;
        }

        .server-address-box input:focus {
            outline: none;
            border-color: #667eea;
        }

        .server-examples {
            margin-top: 12px;
            padding: 10px;
            background: #0f3460;
            border-radius: 6px;
        }

        .server-examples-title {
            color: #667eea;
            font-size: 9pt;
            font-weight: bold;
            margin-bottom: 8px;
        }

        .server-example-item {
            padding: 6px 8px;
            background: #16213e;
            border-radius: 4px;
            margin-bottom: 4px;
            font-size: 9pt;
            color: #ccc;
            cursor: pointer;
            transition: all 0.2s;
            direction: ltr;
            text-align: left;
            font-family: 'Courier New', monospace;
        }

        .server-example-item:hover {
            background: #1e3a5f;
            color: white;
        }

        .server-example-item .example-icon {
            margin-left: 8px;
            direction: rtl;
        }

        .test-connection-btn {
            width: 100%;
            padding: 10px;
            margin-top: 12px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 11pt;
            font-weight: bold;
            transition: all 0.2s;
        }

        .test-connection-btn:hover {
            transform: scale(1.02);
        }

        .test-connection-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }

        .connection-result {
            margin-top: 12px;
            padding: 12px;
            border-radius: 8px;
            font-size: 10pt;
            display: none;
            text-align: right;
        }

        .connection-result.visible {
            display: block;
        }

        .connection-result.success {
            background: rgba(76, 175, 80, 0.15);
            border: 1px solid #4CAF50;
            color: #4CAF50;
        }

        .connection-result.error {
            background: rgba(244, 67, 54, 0.15);
            border: 1px solid #f44336;
            color: #f44336;
        }

        .connection-result.loading {
            background: rgba(102, 126, 234, 0.15);
            border: 1px solid #667eea;
            color: #667eea;
        }

        .connection-result .result-title {
            font-weight: bold;
            margin-bottom: 5px;
        }

        .connection-result .result-detail {
            font-size: 9pt;
            opacity: 0.9;
            line-height: 1.5;
        }

        /* Tooltip راهنما */
        [data-tooltip] {
            position: relative;
        }

        [data-tooltip]:hover::after {
            content: attr(data-tooltip);
            position: absolute;
            bottom: -35px;
            right: 0;
            background: rgba(0, 0, 0, 0.95);
            color: white;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 9pt;
            white-space: nowrap;
            z-index: 1000;
            pointer-events: none;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(102, 126, 234, 0.3);
        }

        /* ═══════════════════════════════════════════ */
        /*              Chat Ticker (Header)           */
        /* ═══════════════════════════════════════════ */
        .chat-ticker {
            display: flex;
            flex-direction: column;
            gap: 2px;
            padding: 4px 12px;
            background: rgba(15, 52, 96, 0.4);
            border-radius: 8px;
            border: 1px solid rgba(102, 126, 234, 0.15);
            cursor: pointer;
            transition: all 0.2s;
            min-width: 280px;
            max-width: 420px;
            overflow: hidden;
        }
        .chat-ticker:hover {
            background: rgba(15, 52, 96, 0.7);
            border-color: rgba(102, 126, 234, 0.4);
        }
        .chat-ticker.hidden {
            display: none;
        }
        .chat-ticker-line {
            font-size: 10pt;
            color: #ccc;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            line-height: 1.4;
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .chat-ticker-line .ticker-user {
            color: #e94560;
            font-weight: bold;
            flex-shrink: 0;
        }
        .chat-ticker-line .ticker-message {
            color: #ccc;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .chat-ticker-line.new {
            animation: tickerFlash 1.5s ease-in-out;
        }
        @keyframes tickerFlash {
            0%, 100% { color: #ccc; }
            50% { color: #FFEB3B; font-weight: bold; }
        }

        /* ═══════════════════════════════════════════ */
        /*              Chat Notification Icon         */
        /* ═══════════════════════════════════════════ */
        .sidebar-trigger-btn.notify {
            background: linear-gradient(135deg, #e94560, #c73650) !important;
            border-color: #e94560 !important;
            animation: notifyPulse 1.2s infinite;
        }
        .sidebar-trigger-btn.notify::after {
            content: '';
            position: absolute;
            top: 2px;
            right: 2px;
            width: 12px;
            height: 12px;
            background: #FFEB3B;
            border-radius: 50%;
            border: 2px solid #1a1a2e;
            box-shadow: 0 0 8px #FFEB3B;
        }
        .sidebar-trigger-btn {
            position: relative;
        }
        @keyframes notifyPulse {
            0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(233, 69, 96, 0.7); }
            50% { transform: scale(1.08); box-shadow: 0 0 0 8px rgba(233, 69, 96, 0); }
        }

        /* ═══════════════════════════════════════════ */
        /*              Chat Settings Section          */
        /* ═══════════════════════════════════════════ */
        .chat-setting-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 0;
            font-size: 11pt;
            color: #ccc;
        }
        .chat-setting-row label {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            flex: 1;
        }
        .chat-setting-row input[type="checkbox"] {
            width: 18px;
            height: 18px;
            accent-color: #4CAF50;
            cursor: pointer;
        }
        .chat-setting-actions {
            display: flex;
            gap: 8px;
            margin-top: 10px;
        }
        .chat-setting-actions button {
            flex: 1;
            padding: 8px 12px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 10pt;
            font-weight: bold;
            transition: all 0.2s;
        }
        .chat-setting-actions button:hover {
            transform: scale(1.03);
        }
        .sound-test-btn {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
        }
        .sound-toggle-btn {
            background: #16213e;
            border: 2px solid #1e3a5f;
            color: white;
        }
        .sound-toggle-btn.muted {
            background: #f44336;
            border-color: #f44336;
        }

        /* ═══════════════════════════════════════════ */
        /*              Responsive                     */
        /* ═══════════════════════════════════════════ */
        @media (max-width: 768px) {
            .glass-btn { width: 42px; height: 42px; font-size: 16pt; }
            .glass-control-bar { padding: 6px 10px; gap: 5px; }
            .sidebar-panel.open { width: 90vw; }
            .sidebar-panel-body { min-width: auto; }
            .top-bar .center { display: none; }
        }
    </style>
</head>
<body>

<!-- ═══════════════════════════════════════════ -->
<!--              Join Modal                     -->
<!-- ═══════════════════════════════════════════ -->
<div class="modal" id="joinModal">
    <div class="modal-content">
        <h1>🎓 کلاس آنلاین</h1>
        <p class="modal-subtitle">مدرسه هوشمند — ورود به کلاس</p>

        <!-- ═══ اطلاعات ورود ═══ -->
        <div class="modal-section">
            <div class="modal-section-title">
                <span>📝 اطلاعات ورود</span>
            </div>

            <label style="display:block; color:#999; font-size:10pt; margin-bottom:6px;">کد اتاق:</label>
            <input type="text" id="inputRoomId" placeholder="مثلاً: class-101" value="class-101" data-tooltip="کدی که معلم به شما داده است">
            <div class="input-hint">💡 کد اتاق را از معلم خود بگیرید</div>

            <label style="display:block; color:#999; font-size:10pt; margin-bottom:6px;">نام شما:</label>
            <input type="text" id="inputUserName" placeholder="نام و نام خانوادگی" data-tooltip="نامی که برای دیگران نمایش داده می‌شود">
            <div class="input-hint">💡 نام واقعی خود را وارد کنید</div>

            <label style="display:block; color:#999; font-size:10pt; margin-bottom:6px;">نقش شما:</label>
            <select id="inputRole" data-tooltip="نقش شما در کلاس">
                <option value="student">👨‍🎓 دانش‌آموز</option>
                <option value="teacher">👨‍🏫 معلم</option>
            </select>
            <div class="input-hint">💡 معلم می‌تواند کلاس را مدیریت کند</div>
        </div>

        <!-- ═══ تنظیمات پیشرفته (سرور) ═══ -->
        <div class="modal-section" style="padding: 0; background: transparent;">
            <div class="modal-section-title" style="background: #0f3460; padding: 12px 15px; border-radius: 10px; margin-bottom: 0;">
                <span>⚙️ اتصال به سرور</span>
                <button class="advanced-toggle" id="advancedToggleBtn" onclick="toggleAdvancedSettings()">
                    ▼ باز کردن
                </button>
            </div>

            <div class="advanced-content" id="advancedContent">
                <div style="background: #0f3460; border-radius: 0 0 10px 10px; padding: 15px; margin-top: 5px;">

                    <div class="server-mode-options">
                        <label class="server-mode-option selected" id="modeDefaultLabel">
                            <input type="radio" name="serverMode" value="default" checked onchange="toggleServerMode()">
                            <div class="option-content">
                                <div class="option-title">🌐 استفاده از سرور پیش‌فرض</div>
                                <div class="option-desc">
                                    سرور اینترنتی — همیشه در دسترس از هر جا
                                </div>
                            </div>
                        </label>

                        <label class="server-mode-option" id="modeCustomLabel">
                            <input type="radio" name="serverMode" value="custom" onchange="toggleServerMode()">
                            <div class="option-content">
                                <div class="option-title">🔧 اتصال به سرور سفارشی</div>
                                <div class="option-desc">
                                    سرور مدرسه، شبکه داخلی، یا سرور اختصاصی
                                </div>
                            </div>
                        </label>
                    </div>

                    <div class="server-address-box" id="serverAddressBox">
                        <label>📍 آدرس سرور:</label>
                        <input type="text" id="inputServerAddress" 
                               placeholder="http://192.168.1.100:8686" 
                               dir="ltr"
                               data-tooltip="آدرس کامل سرور با پورت">

                        <div class="server-examples">
                            <div class="server-examples-title">📋 نمونه‌ها (کلیک کنید):</div>
                            <div class="server-example-item" onclick="setServerExample('http://localhost:8686')">
                                <span class="example-icon">🖥️</span>http://localhost:8686
                            </div>
                            <div class="server-example-item" onclick="setServerExample('http://192.168.1.100:8686')">
                                <span class="example-icon">🏫</span>http://192.168.1.100:8686
                            </div>
                            <div class="server-example-item" onclick="setServerExample('https://myschool.ir')">
                                <span class="example-icon">🌐</span>https://myschool.ir
                            </div>
                        </div>

                        <button class="test-connection-btn" id="testConnectionBtn" onclick="testServerConnection()">
                            🔌 تست اتصال
                        </button>

                        <div class="connection-result" id="connectionResult"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ دکمه ورود ═══ -->
        <button onclick="joinRoom()" style="margin-top: 20px;">🚀 ورود به کلاس</button>

        <p style="color:#666; font-size:9pt; margin-top:15px; text-align:center;">
            💡 اگر مطمئن نیستید، فقط «سرور پیش‌فرض» را انتخاب کنید
        </p>
    </div>
</div>

<!-- ═══════════════════════════════════════════ -->
<!--              App                            -->
<!-- ═══════════════════════════════════════════ -->
<div id="app">

    <!-- ═══ Top Bar ═══ -->
    <header class="top-bar">
        <div class="left">
            <span class="app-logo">🎓 کلاس آنلاین</span>
            <div class="mode-indicator" id="modeIndicator">🎬 Grid</div>
        </div>
        <div class="center" style="flex: 1; justify-content: center; max-width: 450px;">
            <!-- ⭐ نوار پیام‌ها در هدر -->
            <div class="chat-ticker hidden" id="chatTicker" onclick="openSidebar('chat')">
                <div class="chat-ticker-line" id="tickerLine1"></div>
                <div class="chat-ticker-line" id="tickerLine2"></div>
                <div class="chat-ticker-line" id="tickerLine3"></div>
            </div>
        </div>
        <div class="right">
            <span class="room-badge" style="margin-left: 8px;">اتاق: <b id="displayRoomId">---</b></span>
            <span class="online-badge">👥 <span id="onlineCount">0</span></span>
            <span class="connection-status offline" id="connectionStatus">قطع</span>
        </div>
    </header>

    <!-- ═══ Content Area ═══ -->
    <div class="content-area">

        <main class="main-stage" id="mainStage">

            <!-- Grid View -->
            <div id="gridView" class="view active">
                <div class="videos-grid" id="videosGrid">
                    <div class="video-container" id="localVideoContainer">
                        <video id="localVideo" autoplay muted playsinline></video>
                        <div class="user-label" id="localLabel">🎥 شما</div>
                        <div class="mic-status" id="localMicStatus">🎤</div>
                    </div>
                </div>
            </div>

            <!-- Camera View -->
            <div id="cameraView" class="view">
                <video id="cameraViewVideo" autoplay playsinline></video>
            </div>

            <!-- Screen View -->
            <div id="screenView" class="view">
                <video id="screenViewVideo" autoplay playsinline></video>
            </div>

            <!-- Whiteboard View -->
            <div id="whiteboardView" class="view">
                <div class="wb-tools-bar" id="wbToolsBar">
                    <button class="wb-btn active" id="toolPen" onclick="setTool('pen')">✏️ قلم</button>
                    <button class="wb-btn" id="toolEraser" onclick="setTool('eraser')">🧽 پاک‌کن</button>
                    <button class="wb-btn" id="toolText" onclick="setTool('text')">🅰️ متن</button>

                    <span style="color:#999;margin:0 5px;">|</span>
                    <div class="wb-color active" style="background:#000000;" onclick="setColor('#000000', this)"></div>
                    <div class="wb-color" style="background:#f44336;" onclick="setColor('#f44336', this)"></div>
                    <div class="wb-color" style="background:#2196F3;" onclick="setColor('#2196F3', this)"></div>
                    <div class="wb-color" style="background:#4CAF50;" onclick="setColor('#4CAF50', this)"></div>
                    <div class="wb-color" style="background:#FF9800;" onclick="setColor('#FF9800', this)"></div>
                    <div class="wb-color" style="background:#9C27B0;" onclick="setColor('#9C27B0', this)"></div>
                    <div class="wb-color" style="background:#FFEB3B;" onclick="setColor('#FFEB3B', this)"></div>

                    <span style="color:#999;margin:0 5px;">|</span>
                    <label style="color:#eee;font-size:10pt;">اندازه:</label>
                    <input type="range" id="brushSize" min="1" max="30" value="3" oninput="setBrushSize(this.value)" class="wb-size-range">
                    <span id="brushSizeLabel" style="color:white;font-size:10pt;width:20px;">3</span>

                    <span style="color:#999;margin:0 5px;">|</span>
                    <button class="wb-btn" style="background:#f44336;" onclick="clearWhiteboard()">🗑️ پاک کردن</button>
                </div>
                <div class="wb-canvas-wrap">
                    <canvas id="whiteboardCanvas"></canvas>
                    <div id="noAccessMsg">
                        <div style="font-size:30pt;margin-bottom:15px;">🔒</div>
                        <div>شما اجازه دیدن تخته سفید را ندارید</div>
                        <div style="font-size:10pt;color:#999;margin-top:10px;">معلم می‌تواند دسترسی شما را فعال کند</div>
                    </div>
                </div>
            </div>

        </main>

    </div>

</div>

<!-- ═══════════════════════════════════════════ -->
<!--              Hover Sidebars                 -->
<!-- ═══════════════════════════════════════════ -->

<!-- Trigger Buttons (همیشه نمایان) -->
<div class="sidebar-trigger">
    <button class="sidebar-trigger-btn" id="triggerChat" onclick="toggleSidebar('chat')" onmouseenter="hoverSidebar('chat')">💬</button>
    <button class="sidebar-trigger-btn" id="triggerParticipants" onclick="toggleSidebar('participants')" onmouseenter="hoverSidebar('participants')">👥</button>
    <button class="sidebar-trigger-btn teacher-only" id="triggerControl" onclick="toggleSidebar('control')" onmouseenter="hoverSidebar('control')">⚙️</button>
</div>

<!-- Chat Sidebar -->
<aside class="sidebar-panel" id="sidebarChat" onmouseleave="scheduleClose('chat')">
    <div class="sidebar-panel-header">
        <span>💬 چت کلاس</span>
        <button onclick="closeSidebar('chat')" style="background:transparent;border:none;color:#e94560;font-size:14pt;cursor:pointer;">✖</button>
    </div>
    <div class="chat-messages" id="chatMessages"></div>
    <div class="chat-input">
        <input type="text" id="chatInput" placeholder="پیام..." onkeypress="if(event.key==='Enter')sendChat()">
        <button onclick="sendChat()">📨</button>
    </div>
</aside>

<!-- Participants Sidebar -->
<aside class="sidebar-panel" id="sidebarParticipants" onmouseleave="scheduleClose('participants')">
    <div class="sidebar-panel-header">
        <span>👥 شرکت‌کنندگان</span>
        <button onclick="closeSidebar('participants')" style="background:transparent;border:none;color:#e94560;font-size:14pt;cursor:pointer;">✖</button>
    </div>
    <div class="sidebar-panel-body">
        <div class="participants-list" id="participantsList"></div>
    </div>
</aside>

<!-- Control Sidebar (فقط معلم) -->
<aside class="sidebar-panel teacher-only" id="sidebarControl" onmouseleave="scheduleClose('control')">
    <div class="sidebar-panel-header">
        <span>⚙️ کنترل محیط</span>
        <button onclick="closeSidebar('control')" style="background:transparent;border:none;color:#e94560;font-size:14pt;cursor:pointer;">✖</button>
    </div>
    <div class="sidebar-panel-body">

        <!-- حالت‌ها -->
        <div class="control-section">
            <h3>🎬 حالت نمایش</h3>
            <div class="mode-buttons-grid">
                <button class="mode-btn" data-mode="grid" onclick="setMode('grid')">
                    <span class="mode-icon">🎬</span>
                    <span class="mode-label">Grid</span>
                </button>
                <button class="mode-btn" data-mode="camera" onclick="setMode('camera')">
                    <span class="mode-icon">📹</span>
                    <span class="mode-label">دوربین معلم</span>
                </button>
                <button class="mode-btn" data-mode="whiteboard" onclick="setMode('whiteboard')">
                    <span class="mode-icon">🎨</span>
                    <span class="mode-label">تخته سفید</span>
                </button>
                <button class="mode-btn" data-mode="screen" onclick="setMode('screen')">
                    <span class="mode-icon">🖥️</span>
                    <span class="mode-label">اشتراک صفحه</span>
                </button>
            </div>
        </div>

        <!-- ⭐ اعلان‌های چت -->
        <div class="control-section">
            <h3>🔔 اعلان‌های چت</h3>
            
            <div class="chat-setting-row">
                <label>
                    <input type="checkbox" id="settingSound" onchange="saveChatSettings()">
                    <span>صدای اعلان (دینگ)</span>
                </label>
            </div>
            
            <div class="chat-setting-row">
                <label>
                    <input type="checkbox" id="settingIcon" onchange="saveChatSettings()">
                    <span>تغییر رنگ آیکون چت</span>
                </label>
            </div>
            
            <div class="chat-setting-row">
                <label>
                    <input type="checkbox" id="settingTicker" onchange="saveChatSettings()">
                    <span>نمایش پیام در هدر</span>
                </label>
            </div>
            
            <div class="chat-setting-actions">
                <button class="sound-test-btn" onclick="playDing(true)">🔊 تست صدا</button>
                <button class="sound-toggle-btn" id="soundToggleBtn" onclick="toggleSoundMute()">🔊 قطع صدا</button>
            </div>
        </div>

        <!-- کنترل تخته سفید -->
        <div class="control-section">
            <h3>🎨 کنترل تخته سفید</h3>
            <button class="control-btn" onclick="openPermissionsModal()">
                ⚙️ تنظیم دسترسی‌ها
            </button>
            <button class="control-btn secondary" onclick="clearWhiteboard()">
                🗑️ پاک کردن تخته
            </button>
        </div>

        <!-- راهنمای سریع -->
        <div class="control-section" style="background: linear-gradient(135deg, #1e3a5f, #0f3460);">
            <h3>📖 راهنمای سریع</h3>
            
            <div style="color:#ccc; font-size:10pt; line-height:2;">
                <div>🎬 <b>حالت‌ها:</b> تغییر نمای کلاس برای همه</div>
                <div>🎨 <b>تخته سفید:</b> رسم + متن + کنترل دسترسی</div>
                <div>🔔 <b>اعلان‌ها:</b> صدا + آیکون + نوار پیام</div>
