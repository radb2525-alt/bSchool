const modeNames = { grid: 'Grid', camera: 'دوربین معلم', whiteboard: 'تخته سفید', screen: 'اشتراک صفحه' };
const modeIcons = { grid: '🎬', camera: '📹', whiteboard: '🎨', screen: '🖥️' };

// ═══════════════════════════════════════════
//              Join Room
// ═══════════════════════════════════════════
async function joinRoom() {
    roomId = document.getElementById('inputRoomId').value.trim();
    userName = document.getElementById('inputUserName').value.trim();
    userRole = document.getElementById('inputRole').value;

    if (!roomId || !userName) { alert('لطفاً همه فیلدها را پر کنید'); return; }

    // ⭐ ذخیره تنظیمات سرور قبل از ورود
    const selectedMode = document.querySelector('input[name="serverMode"]:checked')?.value || 'default';
    
    if (selectedMode === 'custom') {
        const address = document.getElementById('inputServerAddress')?.value.trim() || '';
        if (!address) {
            alert('⚠️ لطفاً آدرس سرور سفارشی را وارد کنید یا «تست اتصال» را بزنید');
            return;
        }
        
        serverSettings.useCustom = true;
        serverSettings.serverAddress = address;
        saveServerSettings();
        updateWebSocketUrl();
    } else {
        serverSettings.useCustom = false;
        saveServerSettings();
        updateWebSocketUrl();
    }
    
    console.log('🚀 Joining with WS URL:', WS_URL);

    document.getElementById('joinModal').classList.add('hidden');
    document.getElementById('app').classList.add('visible');
    document.getElementById('displayRoomId').textContent = roomId;
    document.getElementById('infoRoomId').textContent = roomId;
    document.getElementById('infoRole').textContent = userRole === 'teacher' ? '👨‍🏫 معلم' : '👨‍🎓 دانش‌آموز';

    document.querySelectorAll('.teacher-only').forEach(el => {
        el.style.display = (userRole === 'teacher') ? '' : 'none';
    });

    try {
        localStream = await navigator.mediaDevices.getUserMedia({
            video: { width: 640, height: 480, facingMode: 'user' },
            audio: { echoCancellation: true, noiseSuppression: true, autoGainControl: true }
        });
        document.getElementById('localVideo').srcObject = localStream;
        document.getElementById('localLabel').textContent = `🎥 ${escapeHtml(userName)} (شما)`;
        if (userRole === 'teacher') document.getElementById('localLabel').classList.add('teacher');
        console.log('✅ دوربین فعال شد');
    } catch (e) {
        console.error('❌', e);
        let msg = '⚠️ دسترسی به دوربین/میکروفن داده نشد\n';
        if (e.name === 'NotAllowedError') msg += 'شما اجازه نداده‌اید.';
        else if (e.name === 'NotFoundError') msg += 'دوربین یافت نشد.';
        else msg += e.message;
        alert(msg);
    }

    connectWS();
}

// ═══════════════════════════════════════════
//              WebSocket
// ═══════════════════════════════════════════
function connectWS() {
    try {
        // ⭐ اطمینان از به‌روز بودن URL
        updateWebSocketUrl();
        
        console.log('🔌 Connecting to:', WS_URL);
        ws = new WebSocket(WS_URL);
        ws.onopen = () => {
            console.log('✅ WS connected');
            document.getElementById('connectionStatus').textContent = 'آنلاین';
            document.getElementById('connectionStatus').className = 'connection-status online';
            document.getElementById('infoConnection').textContent = 'آنلاین';
            document.getElementById('infoConnection').style.color = '#4CAF50';

            ws.send(JSON.stringify({
                type: 'join', room_id: roomId, user_id: userId,
                user_name: userName, role: userRole
            }));
            reconnectAttempts = 0;
            addSystemMessage('✅ به کلاس متصل شدید');
        };
        ws.onmessage = (e) => {
            try { handleMessage(JSON.parse(e.data)); }
            catch (err) { console.error('Msg parse:', err); }
        };
        ws.onclose = () => {
            document.getElementById('connectionStatus').textContent = 'قطع';
            document.getElementById('connectionStatus').className = 'connection-status offline';
            document.getElementById('infoConnection').textContent = 'قطع';
            document.getElementById('infoConnection').style.color = '#f44336';
            if (!intentionalClose && reconnectAttempts < 5) {
                reconnectAttempts++;
                setTimeout(connectWS, 2000);
            }
        };
        ws.onerror = (e) => console.error('WS:', e);
    } catch (e) { console.error('Connect:', e); }
}

// ═══════════════════════════════════════════
//              Message Handler
// ═══════════════════════════════════════════
function handleMessage(data) {
    switch (data.type) {
        case 'room_info':
            if (data.data) {
                if (data.data.students) {
                    data.data.students.forEach(s => {
                        remoteNames[s.id] = s.name;
                        if (s.id !== userId) createPeerConnection(s.id, s.name);
                    });
                }
                if (data.data.teacher && data.data.teacher.id !== userId) {
                    remoteNames[data.data.teacher.id] = data.data.teacher.name;
                    remoteRoles[data.data.teacher.id] = 'teacher';
                    createPeerConnection(data.data.teacher.id, data.data.teacher.name);
                }
                if (data.data.members) { roomMembers = data.data.members; updateParticipantsList(); }
                if (data.data.currentMode) { currentMode = data.data.currentMode; applyMode(currentMode); }
                if (data.data.whiteboard) { wbPermissions = data.data.whiteboard; applyWBPermissions(); }
                document.getElementById('onlineCount').textContent = data.data.online_count || 0;
                document.getElementById('infoOnlineCount').textContent = data.data.online_count || 0;
            }
            break;

        case 'whiteboard': handleWhiteboard(data.data); break;

        case 'user_joined':
            addSystemMessage(`🔵 ${data.user_name} وارد شد`);
            document.getElementById('onlineCount').textContent = data.online_count;
            document.getElementById('infoOnlineCount').textContent = data.online_count;
            remoteNames[data.user_id] = data.user_name;
            if (data.role) remoteRoles[data.user_id] = data.role;
            if (data.user_id !== userId) createPeerConnection(data.user_id, data.user_name);
            break;

        case 'user_left':
            addSystemMessage(`🔴 ${data.user_name || 'کاربر'} خارج شد`);
            removePeerConnection(data.user_id);
            delete remoteNames[data.user_id];
            delete remoteRoles[data.user_id];
            break;

        case 'members_update':
            roomMembers = data.members || [];
            document.getElementById('onlineCount').textContent = data.online_count || roomMembers.length;
            document.getElementById('infoOnlineCount').textContent = data.online_count || roomMembers.length;
            updateParticipantsList();
            break;

        case 'chat_message':
            addChatMessage(data.user, data.message, data.time);
            // ⭐ اگر پیام از خودم نیست:
            if (data.user !== userName) {
                addMessageToTicker(data.user, data.message, data.time);
                if (!chatSidebarOpen) {
                    unreadCount++;
                    setChatIconNotify(true);
                    playDing();
                }
            }
            break;

        case 'hand_raised':
            addSystemMessage(`✋ ${data.user_name} سوال دارد`);
            highlightHandRaised(data.user_name);
            break;

        case 'hand_lowered':
            addSystemMessage(`✋ یک کاربر سوال خود را برداشت`);
            removeHandHighlights();
            break;

        case 'signal': handleSignal(data); break;

        case 'mode_changed':
            currentMode = data.mode;
            applyMode(currentMode);
            addSystemMessage(`🎬 حالت → "${modeNames[data.mode]}"`);
            break;

        case 'whiteboard_permissions_changed':
            wbPermissions = data.whiteboard;
            applyWBPermissions();
            addSystemMessage(`⚙️ دسترسی تخته سفید به‌روزرسانی شد`);
            break;

        case 'screen_share_started':
            addSystemMessage(`🖥️ ${data.user_name} صفحه‌اش را اشتراک گذاشت`);
            break;

        case 'screen_share_stopped':
            addSystemMessage(`🖥️ ${data.user_name} اشتراک را قطع کرد`);
            break;

        case 'pong': break;
    }
}

// ═══════════════════════════════════════════
//              Sidebar Management
// ═══════════════════════════════════════════
function toggleSidebar(name) {
    if (activeSidebar === name) {
        closeSidebar(name);
    } else {
        openSidebar(name);
    }
}

function hoverSidebar(name) {
    // لغو timer بسته شدن این سایدبار
    if (sidebarCloseTimers[name]) {
        clearTimeout(sidebarCloseTimers[name]);
        delete sidebarCloseTimers[name];
    }
    openSidebar(name);
}

function openSidebar(name) {
    // ⭐ اگر سایدبار چت باز می‌شود، پیام‌ها را خوانده‌شده کن
    if (name === 'chat') {
        chatSidebarOpen = true;
        setTimeout(markChatAsRead, 500);
    }

    // بستن سایدبار قبلی
    if (activeSidebar && activeSidebar !== name) {
        closeSidebar(activeSidebar);
    }

    const panel = document.getElementById('sidebar' + name.charAt(0).toUpperCase() + name.slice(1));
    const trigger = document.getElementById('trigger' + name.charAt(0).toUpperCase() + name.slice(1));

    if (panel) panel.classList.add('open');
    if (trigger) trigger.classList.add('active');
    activeSidebar = name;
}

function closeSidebar(name) {
    const panel = document.getElementById('sidebar' + name.charAt(0).toUpperCase() + name.slice(1));
    const trigger = document.getElementById('trigger' + name.charAt(0).toUpperCase() + name.slice(1));

    if (panel) panel.classList.remove('open');
    if (trigger) {
        trigger.classList.remove('active');
        // ⭐ آیکون notify را حفظ کن (اگر پیام خوانده‌نشده هست)
        if (name === 'chat' && unreadCount > 0) {
            // notify را نگه دار
        }
    }
    if (activeSidebar === name) activeSidebar = null;

    // ⭐ اگر سایدبار چت بسته شد
    if (name === 'chat') {
        chatSidebarOpen = false;
    }
}

function scheduleClose(name) {
    // بستن با تأخیر — تا اگر موس دوباره برگشت، بسته نشود
    if (sidebarCloseTimers[name]) clearTimeout(sidebarCloseTimers[name]);
    sidebarCloseTimers[name] = setTimeout(() => {
        closeSidebar(name);
        delete sidebarCloseTimers[name];
    }, 300);
}

// ═══════════════════════════════════════════
//              Participants List
// ═══════════════════════════════════════════
function updateParticipantsList() {
    const list = document.getElementById('participantsList');
    if (!list) return;
    list.innerHTML = '';

    if (roomMembers.length === 0) {
        list.innerHTML = '<div style="color:#666;font-size:10pt;text-align:center;padding:20px;">هیچ‌کس حاضر نیست</div>';
        return;
    }

    roomMembers.forEach(m => {
        const item = document.createElement('div');
        item.className = 'participant-item' + (m.role === 'teacher' ? ' teacher' : '');
        item.innerHTML = `
            <span class="role-icon">${m.role === 'teacher' ? '👨‍🏫' : '👨‍🎓'}</span>
            <span class="name">${escapeHtml(m.name)}${m.id === userId ? ' (شما)' : ''}</span>
            <span class="status">🟢</span>
        `;
        list.appendChild(item);
    });
}

// ═══════════════════════════════════════════
//              WebRTC
// ═══════════════════════════════════════════
async function createPeerConnection(peerId, peerName) {
    if (peerConnections[peerId]) return peerConnections[peerId];

    const pc = new RTCPeerConnection(rtcConfig);
    peerConnections[peerId] = pc;
    pendingCandidates[peerId] = [];

    if (localStream) localStream.getTracks().forEach(t => pc.addTrack(t, localStream));

    pc.ontrack = (event) => {
        if (!remoteStreams[peerId]) remoteStreams[peerId] = new MediaStream();
        event.streams[0].getTracks().forEach(t => remoteStreams[peerId].addTrack(t));
        showRemoteVideo(peerId, remoteNames[peerId] || peerName, remoteStreams[peerId]);
    };

    pc.onicecandidate = (e) => {
        if (e.candidate) sendSignal(peerId, { type: 'ice-candidate', candidate: e.candidate });
    };

    pc.onconnectionstatechange = () => {
        if (pc.connectionState === 'failed' || pc.connectionState === 'disconnected') {
            removePeerConnection(peerId);
        }
    };

    const myNum = parseFloat(userId.split('_').pop()) || 0;
    const peerNum = parseFloat(String(peerId).split('_').pop()) || 0;

    if (myNum > peerNum) {
        try {
            const offer = await pc.createOffer();
            await pc.setLocalDescription(offer);
            sendSignal(peerId, { type: 'offer', sdp: pc.localDescription });
        } catch (e) { console.error('Offer:', e); }
    }

    return pc;
}

function removePeerConnection(peerId) {
    if (peerConnections[peerId]) { peerConnections[peerId].close(); delete peerConnections[peerId]; }
    if (remoteStreams[peerId]) { remoteStreams[peerId].getTracks().forEach(t => t.stop()); delete remoteStreams[peerId]; }
    delete pendingCandidates[peerId];
    const c = document.getElementById(`video_${peerId}`);
    if (c) c.remove();
}

function sendSignal(targetId, data) {
    if (ws && ws.readyState === WebSocket.OPEN) {
        ws.send(JSON.stringify({ type: 'signal', target: targetId, data }));
    }
}

async function handleSignal(data) {
    const fromId = data.from;
    let pc = peerConnections[fromId];
    if (!pc) pc = await createPeerConnection(fromId, data.from_name);

    try {
        if (data.data.type === 'offer') {
            await pc.setRemoteDescription(new RTCSessionDescription(data.data.sdp));
            if (pendingCandidates[fromId]) {
                for (const c of pendingCandidates[fromId]) {
                    try { await pc.addIceCandidate(new RTCIceCandidate(c)); } catch(e){}
                }
                pendingCandidates[fromId] = [];
            }
            const ans = await pc.createAnswer();
            await pc.setLocalDescription(ans);
            sendSignal(fromId, { type: 'answer', sdp: pc.localDescription });
        } else if (data.data.type === 'answer') {
            await pc.setRemoteDescription(new RTCSessionDescription(data.data.sdp));
            if (pendingCandidates[fromId]) {
                for (const c of pendingCandidates[fromId]) {
                    try { await pc.addIceCandidate(new RTCIceCandidate(c)); } catch(e){}
                }
                pendingCandidates[fromId] = [];
            }
        } else if (data.data.type === 'ice-candidate') {
            if (data.data.candidate) {
                if (!pc.remoteDescription || !pc.remoteDescription.type) {
                    pendingCandidates[fromId].push(data.data.candidate);
                } else {
                    try { await pc.addIceCandidate(new RTCIceCandidate(data.data.candidate)); } catch(e){}
                }
            }
        }
    } catch (e) { console.error('Signal:', e); }
}

function showRemoteVideo(peerId, peerName, stream) {
    let container = document.getElementById(`video_${peerId}`);
    if (container) {
        const v = container.querySelector('video');
        if (v) v.srcObject = stream;
    } else {
        container = document.createElement('div');
        container.className = 'video-container';
        container.id = `video_${peerId}`;
        const role = remoteRoles[peerId] === 'teacher' ? '👨‍🏫' : '👤';
        const labelClass = remoteRoles[peerId] === 'teacher' ? 'user-label teacher' : 'user-label';
        container.innerHTML = `<video autoplay playsinline></video><div class="${labelClass}">${role} ${escapeHtml(peerName)}</div>`;
        container.querySelector('video').srcObject = stream;
        document.getElementById('videosGrid').appendChild(container);
    }
    if (remoteRoles[peerId] === 'teacher') {
        const cv = document.getElementById('cameraViewVideo');
        if (cv) cv.srcObject = stream;
    }
}

// ═══════════════════════════════════════════
//              Mode Management
// ═══════════════════════════════════════════
function setMode(mode) {
    if (userRole !== 'teacher') return;
    if (!['grid', 'camera', 'whiteboard', 'screen'].includes(mode)) return;
    currentMode = mode;
    applyMode(mode);
    if (ws && ws.readyState === WebSocket.OPEN) {
        ws.send(JSON.stringify({ type: 'set_mode', mode }));
    }
}

function applyMode(mode) {
    document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
    const viewId = mode + 'View';
    const viewEl = document.getElementById(viewId);
    if (viewEl) viewEl.classList.add('active');

    const indicator = document.getElementById('modeIndicator');
    indicator.textContent = `${modeIcons[mode]} ${modeNames[mode]}`;
    indicator.className = 'mode-indicator ' + mode;

    // به‌روزرسانی دکمه‌های mode در سایدبار
    document.querySelectorAll('.mode-btn').forEach(b => {
        b.classList.toggle('active', b.dataset.mode === mode);
    });

    if (mode === 'whiteboard') {
        if (!canViewWhiteboard()) {
            document.getElementById('noAccessMsg').style.display = 'block';
        } else {
            document.getElementById('noAccessMsg').style.display = 'none';
            setTimeout(() => {
                if (canvas) {
                    const cont = canvas.parentElement;
                    canvas.width = cont.clientWidth;
                    canvas.height = cont.clientHeight;
                    if (ctx) {
                        ctx.fillStyle = 'white';
                        ctx.fillRect(0, 0, canvas.width, canvas.height);
                        replayHistory();
                    }
                }
            }, 100);
        }
        setTimeout(applyWBPermissions, 150);
    }

    if (mode === 'camera' && userRole === 'teacher' && localStream) {
        document.getElementById('cameraViewVideo').srcObject = localStream;
    }
}

// ═══════════════════════════════════════════
//              Whiteboard Permissions
// ═══════════════════════════════════════════
function canViewWhiteboard() {
    if (userRole === 'teacher') return true;
    if (wbPermissions.viewMode === 'all') return true;
    if (wbPermissions.viewMode === 'teacher') return false;
    if (wbPermissions.viewMode === 'selected') return wbPermissions.viewers.includes(userId);
    return false;
}

function canDrawWhiteboard() {
    if (userRole === 'teacher') return true;
    if (wbPermissions.drawMode === 'all') return true;
    if (wbPermissions.drawMode === 'teacher') return false;
    if (wbPermissions.drawMode === 'selected') return wbPermissions.drawers.includes(userId);
    return false;
}

function applyWBPermissions() {
    const canView = canViewWhiteboard();
    const canDraw = canDrawWhiteboard();

    if (!canView && currentMode === 'whiteboard') {
        document.getElementById('noAccessMsg').style.display = 'block';
        return;
    } else {
        document.getElementById('noAccessMsg').style.display = 'none';
    }

    if (canvas) {
        if (canDraw) {
            canvas.style.pointerEvents = 'auto';
            canvas.style.cursor = 'crosshair';
            canvas.style.opacity = '1';
        } else {
            canvas.style.pointerEvents = 'none';
            canvas.style.cursor = 'not-allowed';
            canvas.style.opacity = '0.75';
        }
    }

    const toolsBar = document.getElementById('wbToolsBar');
    if (toolsBar && userRole !== 'teacher') {
        toolsBar.style.opacity = canDraw ? '1' : '0.4';
        toolsBar.style.pointerEvents = canDraw ? 'auto' : 'none';
    }
}

// ═══════════════════════════════════════════
//              Permissions Modal
// ═══════════════════════════════════════════
function openPermissionsModal() {
    if (userRole !== 'teacher') return;

    document.querySelectorAll('input[name="viewMode"]').forEach(r => r.checked = r.value === wbPermissions.viewMode);
    document.querySelectorAll('input[name="drawMode"]').forEach(r => r.checked = r.value === wbPermissions.drawMode);

    buildUserCheckboxes('viewersCheckboxes', wbPermissions.viewers, 'viewer');
    buildUserCheckboxes('drawersCheckboxes', wbPermissions.drawers, 'drawer');

    toggleUserList('viewersList', wbPermissions.viewMode === 'selected');
    toggleUserList('drawersList', wbPermissions.drawMode === 'selected');

    document.querySelectorAll('input[name="viewMode"]').forEach(r => {
        r.onchange = () => toggleUserList('viewersList', r.value === 'selected');
    });
    document.querySelectorAll('input[name="drawMode"]').forEach(r => {
        r.onchange = () => toggleUserList('drawersList', r.value === 'selected');
    });

    document.getElementById('permissionsModal').classList.add('show');
}

function closePermissionsModal() {
    document.getElementById('permissionsModal').classList.remove('show');
}

function toggleUserList(id, visible) {
    const el = document.getElementById(id);
    if (visible) el.classList.add('visible');
    else el.classList.remove('visible');
}

function buildUserCheckboxes(containerId, selectedIds, role) {
    const container = document.getElementById(containerId);
    if (!container) return;
    container.innerHTML = '';

    const students = roomMembers.filter(m => m.role === 'student' && m.id !== userId);

    if (students.length === 0) {
        container.innerHTML = '<div style="color:#666;font-size:10pt;">هیچ دانش‌آموزی حاضر نیست</div>';
        return;
    }

    students.forEach(s => {
        const label = document.createElement('label');
        label.className = 'checkbox-item';
        const checked = selectedIds.includes(s.id);
        label.innerHTML = `<input type="checkbox" data-user-id="${s.id}" data-role="${role}" ${checked ? 'checked' : ''}><span>👨‍🎓 ${escapeHtml(s.name)}</span>`;
        container.appendChild(label);
    });
}

function savePermissions() {
    const viewMode = document.querySelector('input[name="viewMode"]:checked').value;
    const drawMode = document.querySelector('input[name="drawMode"]:checked').value;

    const viewers = [];
    const drawers = [];
    document.querySelectorAll('input[data-role="viewer"]:checked').forEach(cb => viewers.push(cb.dataset.userId));
    document.querySelectorAll('input[data-role="drawer"]:checked').forEach(cb => drawers.push(cb.dataset.userId));

    if (viewMode === 'selected' && viewers.length === 0) { alert('⚠️ حداقل یک بیننده انتخاب کنید'); return; }
    if (drawMode === 'selected' && drawers.length === 0) { alert('⚠️ حداقل یک نویسنده انتخاب کنید'); return; }

    wbPermissions = { viewMode, viewers, drawMode, drawers };

    if (ws && ws.readyState === WebSocket.OPEN) {
        ws.send(JSON.stringify({
            type: 'set_whiteboard_permissions',
            viewMode, viewers, drawMode, drawers
        }));
    }

    applyWBPermissions();
    addSystemMessage('⚙️ دسترسی‌ها ذخیره شد');
    closePermissionsModal();
}

// ═══════════════════════════════════════════
//              Chat
// ═══════════════════════════════════════════
function sendChat() {
    const input = document.getElementById('chatInput');
    const msg = input.value.trim();
    if (!msg || !ws || ws.readyState !== WebSocket.OPEN) return;
    ws.send(JSON.stringify({ type: 'chat', message: msg }));
    input.value = '';
}

function addChatMessage(user, message, time) {
    const c = document.getElementById('chatMessages');
    const div = document.createElement('div');
    div.className = 'chat-msg';
    div.innerHTML = `<span class="user">${escapeHtml(user)}:</span> <span class="time">${escapeHtml(time || '')}</span><br>${escapeHtml(message)}`;
    c.appendChild(div);
    div.scrollIntoView({ behavior: 'smooth' });
}

function addSystemMessage(message) {
    const c = document.getElementById('chatMessages');
    const div = document.createElement('div');
    div.className = 'chat-msg system';
    div.textContent = message;
    c.appendChild(div);
    div.scrollIntoView({ behavior: 'smooth' });
}

function escapeHtml(t) {
    if (t == null) return '';
    const d = document.createElement('div');
    d.textContent = String(t);
    return d.innerHTML;
}

// ═══════════════════════════════════════════
//              Controls
// ═══════════════════════════════════════════
function toggleMic() {
    micOn = !micOn;
    if (localStream) localStream.getAudioTracks().forEach(t => t.enabled = micOn);
    const btn = document.getElementById('btnMic');
    btn.classList.toggle('active', micOn);
    btn.classList.toggle('off', !micOn);
    document.getElementById('localMicStatus').textContent = micOn ? '🎤' : '🔇';
}

function toggleCam() {
    camOn = !camOn;
    if (localStream) localStream.getVideoTracks().forEach(t => t.enabled = camOn);
    const btn = document.getElementById('btnCam');
    btn.classList.toggle('active', camOn);
    btn.classList.toggle('off', !camOn);
}

function toggleHand() {
    handRaised = !handRaised;
    if (ws && ws.readyState === WebSocket.OPEN) {
        ws.send(JSON.stringify({ type: handRaised ? 'hand_raise' : 'hand_lower' }));
    }
    const btn = document.getElementById('btnHand');
    btn.classList.toggle('raised', handRaised);
    const lbl = document.getElementById('localLabel');
    if (lbl) lbl.classList.toggle('hand-raised', handRaised);
}

function highlightHandRaised(name) {
    document.querySelectorAll('.user-label').forEach(lbl => {
        if (lbl.textContent.includes(name)) {
            lbl.classList.add('hand-raised');
            const p = lbl.parentElement;
            if (!p.querySelector('.hand-indicator')) {
                const h = document.createElement('div');
                h.className = 'hand-indicator';
                h.textContent = '✋';
                p.appendChild(h);
            }
        }
    });
}

function removeHandHighlights() {
    document.querySelectorAll('.user-label.hand-raised').forEach(l => l.classList.remove('hand-raised'));
    document.querySelectorAll('.hand-indicator').forEach(h => h.remove());
}

// ═══════════════════════════════════════════
//              Whiteboard Toggle
// ═══════════════════════════════════════════
function toggleWhiteboard() {
    if (currentMode === 'whiteboard') {
        if (userRole === 'teacher') setMode('grid');
    } else {
        if (userRole === 'teacher') {
            setMode('whiteboard');
        } else {
            addSystemMessage('⚠️ فقط معلم می‌تواند تخته را فعال کند');
        }
    }
}

// ═══════════════════════════════════════════
//              Screen Share
// ═══════════════════════════════════════════
async function toggleScreenShare() {
    if (screenSharing) stopScreenShare();
    else await startScreenShare();
}

async function startScreenShare() {
    if (userRole !== 'teacher') {
        addSystemMessage('⚠️ فقط معلم می‌تواند صفحه را اشتراک بگذارد');
        return;
    }
    try {
        screenStream = await navigator.mediaDevices.getDisplayMedia({
            video: { cursor: 'always', frameRate: 15 }, audio: false
        });
        screenSharing = true;
        if (ws && ws.readyState === WebSocket.OPEN) {
            ws.send(JSON.stringify({ type: 'screen_share_start' }));
        }
        const btn = document.getElementById('btnScreen');
        btn.classList.add('off');

        const track = screenStream.getVideoTracks()[0];
        for (const pc of Object.values(peerConnections)) {
            const s = pc.getSenders().find(x => x.track && x.track.kind === 'video');
            if (s) await s.replaceTrack(track);
        }
        document.getElementById('screenViewVideo').srcObject = screenStream;
        setMode('screen');
        track.onended = () => stopScreenShare();
        addSystemMessage('🖥️ اشتراک صفحه شروع شد');
    } catch (e) {
        console.error('❌', e);
        screenSharing = false;
        screenStream = null;
        addSystemMessage(e.name === 'NotAllowedError' ? '⚠️ لغو شد' : '⚠️ ' + e.message);
    }
}

function stopScreenShare() {
    if (!screenSharing) return;
    if (screenStream) { screenStream.getTracks().forEach(t => t.stop()); screenStream = null; }
    screenSharing = false;
    const btn = document.getElementById('btnScreen');
    btn.classList.remove('off');
    if (localStream) {
        const cam = localStream.getVideoTracks()[0];
        for (const pc of Object.values(peerConnections)) {
            const s = pc.getSenders().find(x => x.track && x.track.kind === 'video');
            if (s && cam) s.replaceTrack(cam);
        }
    }
    document.getElementById('screenViewVideo').srcObject = null;
    if (ws && ws.readyState === WebSocket.OPEN) {
        ws.send(JSON.stringify({ type: 'screen_share_stop' }));
    }
    if (userRole === 'teacher') setMode('grid');
    addSystemMessage('🖥️ اشتراک صفحه متوقف شد');
}

// ═══════════════════════════════════════════
//              Whiteboard Core
// ═══════════════════════════════════════════
function initWhiteboard() {
    canvas = document.getElementById('whiteboardCanvas');
    if (!canvas) return;
    ctx = canvas.getContext('2d');

    canvas.addEventListener('mousedown', startDrawing);
    canvas.addEventListener('mousemove', draw);
    canvas.addEventListener('mouseup', stopDrawing);
    canvas.addEventListener('mouseout', stopDrawing);
    canvas.addEventListener('touchstart', handleTouchStart, { passive: false });
    canvas.addEventListener('touchmove', handleTouchMove, { passive: false });
    canvas.addEventListener('touchend', stopDrawing);
    canvas.addEventListener('dblclick', handleDoubleClick);

    window.addEventListener('resize', resizeCanvas);
}

function resizeCanvas() {
    if (!canvas || currentMode !== 'whiteboard') return;
    const cont = canvas.parentElement;
    canvas.width = cont.clientWidth;
    canvas.height = cont.clientHeight;
    if (ctx) {
        ctx.fillStyle = 'white';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        replayHistory();
    }
}

function startDrawing(e) {
    if (currentTool === 'text') return;
    if (!canDrawWhiteboard()) return;
    isDrawing = true;
    const r = canvas.getBoundingClientRect();
    lastX = (e.clientX - r.left) / r.width;
    lastY = (e.clientY - r.top) / r.height;
}

function draw(e) {
    if (!isDrawing || !canDrawWhiteboard()) return;
    const r = canvas.getBoundingClientRect();
    const x = (e.clientX - r.left) / r.width;
    const y = (e.clientY - r.top) / r.height;

    drawLine(lastX * canvas.width, lastY * canvas.height, x * canvas.width, y * canvas.height, currentColor, currentBrushSize, currentTool);

    sendWhiteboard({
        type: 'draw', fromX: lastX, fromY: lastY, toX: x, toY: y,
        color: currentColor, size: currentBrushSize, tool: currentTool,
        author: userName
    });

    lastX = x;
    lastY = y;
}

function stopDrawing() { isDrawing = false; }

function handleTouchStart(e) {
    if (currentTool === 'text' || !canDrawWhiteboard()) return;
    e.preventDefault();
    if (e.touches.length > 0) {
        isDrawing = true;
        const r = canvas.getBoundingClientRect();
        lastX = (e.touches[0].clientX - r.left) / r.width;
        lastY = (e.touches[0].clientY - r.top) / r.height;
    }
}

function handleTouchMove(e) {
    if (currentTool === 'text' || !canDrawWhiteboard()) return;
    e.preventDefault();
    if (!isDrawing || e.touches.length === 0) return;
    const r = canvas.getBoundingClientRect();
    const x = (e.touches[0].clientX - r.left) / r.width;
    const y = (e.touches[0].clientY - r.top) / r.height;
    drawLine(lastX * canvas.width, lastY * canvas.height, x * canvas.width, y * canvas.height, currentColor, currentBrushSize, currentTool);
    sendWhiteboard({
        type: 'draw', fromX: lastX, fromY: lastY, toX: x, toY: y,
        color: currentColor, size: currentBrushSize, tool: currentTool,
        author: userName
    });
    lastX = x;
    lastY = y;
}

function handleDoubleClick(e) {
    if (!canDrawWhiteboard()) return;
    e.preventDefault();
    const r = canvas.getBoundingClientRect();
    showTextInput((e.clientX - r.left) / r.width, (e.clientY - r.top) / r.height);
}

function drawLine(x1, y1, x2, y2, color, size, tool) {
    if (!ctx) return;
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2, y2);
    if (tool === 'eraser') {
        ctx.strokeStyle = 'white';
        ctx.lineWidth = size * 5;
    } else {
        ctx.strokeStyle = color;
        ctx.lineWidth = size;
    }
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.stroke();
}

function drawText(x, y, text, color, size) {
    if (!ctx || !text) return;
    ctx.fillStyle = color;
    ctx.font = `${size}px Tahoma`;
    ctx.textBaseline = 'top';
    ctx.fillText(text, x, y);
}

// ═══════════════════════════════════════════
//              Text Tool
// ═══════════════════════════════════════════
function showTextInput(nx, ny) {
    if (!canDrawWhiteboard()) return;
    if (pendingTextInput) { pendingTextInput.remove(); pendingTextInput = null; }

    const r = canvas.getBoundingClientRect();
    const input = document.createElement('input');
    input.type = 'text';
    input.placeholder = 'متن...';
    input.style.cssText = `position:absolute;left:${nx * r.width}px;top:${ny * r.height}px;background:rgba(255,255,255,0.95);border:2px solid #e94560;padding:5px 10px;font-size:16pt;font-family:Tahoma;z-index:100;min-width:200px;border-radius:4px;outline:none;`;
    canvas.parentElement.appendChild(input);
    input.focus();
    pendingTextInput = input;

    input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
            const text = input.value.trim();
            if (text) {
                drawText(nx * canvas.width, ny * canvas.height, text, currentColor, currentBrushSize * 8);
                sendWhiteboard({
                    type: 'text', x: nx, y: ny, text, color: currentColor,
                    size: currentBrushSize, author: userName
                });
            }
            input.remove();
            pendingTextInput = null;
        } else if (e.key === 'Escape') {
            input.remove();
            pendingTextInput = null;
        }
    });

    input.addEventListener('blur', () => {
        setTimeout(() => {
            if (pendingTextInput === input) { input.remove(); pendingTextInput = null; }
        }, 200);
    });
}

// ═══════════════════════════════════════════
//              Tools
// ═══════════════════════════════════════════
function setColor(color, el) {
    currentColor = color;
    if (currentTool !== 'pen') { setTool('pen'); }
    document.querySelectorAll('.wb-color').forEach(e => e.classList.remove('active'));
    el.classList.add('active');
}

function setBrushSize(size) {
    currentBrushSize = parseInt(size);
    document.getElementById('brushSizeLabel').textContent = size;
}

function setTool(tool) {
    currentTool = tool;
    ['pen', 'eraser', 'text'].forEach(t => {
        const btn = document.getElementById('tool' + t.charAt(0).toUpperCase() + t.slice(1));
        if (btn) btn.classList.toggle('active', t === tool);
    });
    if (canvas) canvas.style.cursor = tool === 'text' ? 'text' : 'crosshair';
}

function clearWhiteboard() {
    if (!canDrawWhiteboard() || !ctx) return;
    ctx.fillStyle = 'white';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    sendWhiteboard({ type: 'clear', author: userName });
    whiteboardHistory = [];
    addSystemMessage('🗑️ تخته پاک شد');
}

// ═══════════════════════════════════════════
//              Whiteboard Network
// ═══════════════════════════════════════════
function sendWhiteboard(data) {
    if (ws && ws.readyState === WebSocket.OPEN) {
        ws.send(JSON.stringify({ type: 'whiteboard', data }));
    }
}

function handleWhiteboard(data) {
    if (!data) return;

    if (data.type !== 'clear') {
        whiteboardHistory.push(data);
        if (whiteboardHistory.length > 5000) whiteboardHistory.shift();
    } else {
        whiteboardHistory = [];
    }

    if (currentMode !== 'whiteboard' || !ctx) return;
    if (!canViewWhiteboard()) return;

    if (data.type === 'draw') {
        drawLine(
            data.fromX * canvas.width, data.fromY * canvas.height,
            data.toX * canvas.width, data.toY * canvas.height,
            data.color, data.size, data.tool
        );
    } else if (data.type === 'text') {
        drawText(data.x * canvas.width, data.y * canvas.height, data.text, data.color, data.size * 8);
    } else if (data.type === 'clear') {
        ctx.fillStyle = 'white';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
    }
}

function replayHistory() {
    if (!ctx || !whiteboardHistory.length) return;
    whiteboardHistory.forEach(data => {
        if (data.type === 'draw') {
            drawLine(
                data.fromX * canvas.width, data.fromY * canvas.height,
                data.toX * canvas.width, data.toY * canvas.height,
                data.color, data.size, data.tool
            );
        } else if (data.type === 'text') {
            drawText(data.x * canvas.width, data.y * canvas.height, data.text, data.color, data.size * 8);
        } else if (data.type === 'clear') {
            ctx.fillStyle = 'white';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
        }
    });
}

// ═══════════════════════════════════════════
//              Leave
// ═══════════════════════════════════════════
function leaveRoom() {
    if (!confirm('از کلاس خارج می‌شوید؟')) return;
    intentionalClose = true;
    if (screenSharing) stopScreenShare();
    if (localStream) localStream.getTracks().forEach(t => t.stop());
    Object.keys(peerConnections).forEach(id => peerConnections[id].close());
    if (ws) ws.close();
    location.reload();
}

// ═══════════════════════════════════════════
//              Init
// ═══════════════════════════════════════════
window.addEventListener('DOMContentLoaded', () => {
    initWhiteboard();
    loadChatSettings();
    loadServerSettings();
    console.log('✅ App v3.5 initialized (custom server + guide)');
    
    // فعال‌سازی AudioContext با اولین تعامل کاربر
    document.body.addEventListener('click', function initAudio() {
        if (!audioContext) {
            try {
                audioContext = new (window.AudioContext || window.webkitAudioContext)();
            } catch (e) {}
        }
        if (audioContext && audioContext.state === 'suspended') {
            audioContext.resume();
        }
        document.body.removeEventListener('click', initAudio);
    }, { once: true });
});

// بستن سایدبارها با کلیک خارج
document.addEventListener('click', (e) => {
    if (activeSidebar) {
        const panel = document.getElementById('sidebar' + activeSidebar.charAt(0).toUpperCase() + activeSidebar.slice(1));
        const trigger = document.getElementById('trigger' + activeSidebar.charAt(0).toUpperCase() + activeSidebar.slice(1));
        if (panel && !panel.contains(e.target) && trigger && !trigger.contains(e.target)) {
            closeSidebar(activeSidebar);
        }
    }
});

setInterval(() => {
    if (ws && ws.readyState === WebSocket.OPEN) ws.send(JSON.stringify({ type: 'ping' }));
}, 30000);

window.addEventListener('beforeunload', () => {
    if (localStream) localStream.getTracks().forEach(t => t.stop());
    if (screenStream) screenStream.getTracks().forEach(t => t.stop());
    if (ws && ws.readyState === WebSocket.OPEN) ws.close();
});
</script>

