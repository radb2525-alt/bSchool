<script>
// ═══════════════════════════════════════════
//              Configuration
// ═══════════════════════════════════════════

// ⭐ URL سرور (قابل تغییر توسط کاربر)
let SERVER_BASE_URL = `${location.protocol}//${location.host}`;
let WS_URL = '';

// تنظیمات سرور (از localStorage)
let serverSettings = {
    useCustom: false,
    serverAddress: ''
};

const SERVER_SETTINGS_KEY = 'classroom_server_settings';

// ⭐ ساخت WebSocket URL از Base URL
function buildWebSocketUrl(baseUrl) {
    if (!baseUrl) baseUrl = SERVER_BASE_URL;
    
    // حذف / در انتها
    baseUrl = baseUrl.replace(/\/$/, '');
    
    if (baseUrl.startsWith('https://')) {
        return baseUrl.replace('https://', 'wss://') + '/ws';
    } else if (baseUrl.startsWith('http://')) {
        return baseUrl.replace('http://', 'ws://') + '/ws';
    } else {
        // اگر پروتکل نداشت
        const protocol = location.protocol === 'https:' ? 'wss://' : 'ws://';
        return protocol + baseUrl + '/ws';
    }
}

// ⭐ به‌روزرسانی WS_URL بر اساس تنظیمات فعلی
function updateWebSocketUrl() {
    let baseUrl;
    
    if (serverSettings.useCustom && serverSettings.serverAddress) {
        baseUrl = serverSettings.serverAddress.trim();
        // اگر پروتکل نداشت، اضافه کن
        if (!baseUrl.startsWith('http://') && !baseUrl.startsWith('https://')) {
            baseUrl = 'http://' + baseUrl;
        }
    } else {
        baseUrl = SERVER_BASE_URL;
    }
    
    WS_URL = buildWebSocketUrl(baseUrl);
    console.log('🌐 WebSocket URL:', WS_URL);
    return WS_URL;
}

// ═══════════════════════════════════════════
//              Global State
// ═══════════════════════════════════════════
let ws = null;
let localStream = null;
let roomId = '';
let userId = 'user_' + Date.now() + '_' + Math.floor(Math.random() * 1000);
let userName = '';
let userRole = 'student';
let micOn = true;
let camOn = true;
let handRaised = false;
let reconnectAttempts = 0;
let intentionalClose = false;

let peerConnections = {};
let remoteStreams = {};
let pendingCandidates = {};
let remoteNames = {};
let remoteRoles = {};

let screenStream = null;
let screenSharing = false;
let currentMode = 'grid';

let roomMembers = [];
let wbPermissions = {
    viewMode: 'all',
    viewers: [],
    drawMode: 'teacher',
    drawers: [],
};

// Whiteboard
let canvas = null;
let ctx = null;
let isDrawing = false;
let lastX = 0;
let lastY = 0;
let currentColor = '#000000';
let currentBrushSize = 3;
let currentTool = 'pen';
let whiteboardHistory = [];
